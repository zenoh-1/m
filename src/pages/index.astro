---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import QuickEnergyCost from '../components/home/QuickEnergyCost.astro';
import DecisionJourney from '../components/home/DecisionJourney.astro';
import SystemSignal from '../components/SystemSignal.astro';
import AmbientHomeScene from '../components/AmbientHomeScene.astro';
import { HOME_SYSTEMS } from '../data/homeSystems';
---

<Layout path="/" structuredData={true}>
  <SiteHeader />

  <main id="main-content">
    <section class="cost-hero" aria-labelledby="cost-hero-title">
      <AmbientHomeScene variant="landing" />
      <div class="container-page cost-hero__frame">
        <div class="cost-hero__register" aria-hidden="true"><span>CF / HOME OPS</span><span>MANUAL 001</span></div>
        <div class="cost-hero__grid">
        <div class="cost-hero__copy" data-reveal>
          <span class="eyebrow">Home cost intelligence</span>
          <h1 id="cost-hero-title">Know what your home costs before it surprises you.</h1>
          <p class="cost-hero__lead">
            Calculate appliance running costs, plan maintenance, and compare repair with replacement—using transparent math you can check.
          </p>
          <div class="cost-hero__actions">
            <a class="btn-primary" href="/systems/">Browse Home Systems</a>
            <a class="btn-secondary" href="/my-home/">Build My Home Plan</a>
          </div>
          <ul class="cost-hero__trust" aria-label="Product principles">
            <li>No account required</li>
            <li>Your values stay on this device</li>
            <li>Sources and assumptions shown</li>
          </ul>
        </div>

        <div class="cost-hero__instrument" data-reveal>
          <span class="cost-hero__instrument-label">Live Home Cost Meter</span>
          <QuickEnergyCost />
        </div>
        </div>
      </div>
    </section>

    <DecisionJourney />

    <section class="section" aria-labelledby="systems-title">
      <div class="container-page">
        <div class="section-head systems-head" data-reveal>
          <div>
            <span class="eyebrow">Start with what you own</span>
            <h2 class="section-title" id="systems-title">8 systems. 1 repeatable method.</h2>
          </div>
          <a class="btn-secondary" href="/systems/">See All System Guides</a>
        </div>
        <div class="home-systems">
          {HOME_SYSTEMS.slice(0, 6).map((system, index) => (
            <a href={`/systems/${system.slug}/`} class:list={['home-system', 'card', { 'home-system--featured': index < 2 }]} data-reveal>
              <div class="home-system__top">
                <span>{String(index + 1).padStart(2, '0')} · {system.category}</span>
                <SystemSignal label={system.shortName} category={system.category} index={index + 1} compact={index >= 2} />
              </div>
              <div class="home-system__copy">
                <h3>{system.shortName}</h3>
                <p>{system.summary}</p>
                <span class="manual-tag">{system.energyInput}</span>
                <b>Cost + Care Guide →</b>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section home-loop" aria-labelledby="home-loop-title">
      <div class="container-page home-loop__grid">
        <div data-reveal>
          <span class="eyebrow">Useful after the first visit</span>
          <h2 class="section-title" id="home-loop-title">Turn one calculation into a home you can keep track of.</h2>
          <p>Save an appliance, its model, the last service date, and what comes next. Export a calendar or JSON backup whenever you want.</p>
          <a class="btn-primary" href="/my-home/">Open My Home</a>
        </div>
        <div class="home-loop__board" data-reveal>
          <div class="home-loop__board-head"><span>Maintenance Board</span><b data-home-preview-status>Example schedule</b></div>
          <ol aria-label="Example maintenance timeline">
            <li><span class="home-loop__state home-loop__state--due">Due</span><div><b>Dryer vent check</b><small>Laundry · Safety first</small></div><time>Today</time></li>
            <li><span class="home-loop__state home-loop__state--soon">Soon</span><div><b>Water heater review</b><small>Water · Manual-led</small></div><time>12 days</time></li>
            <li><span class="home-loop__state home-loop__state--later">Later</span><div><b>AC filter check</b><small>Cooling · Seasonal</small></div><time>41 days</time></li>
          </ol>
          <p>Dates shown are an example. Your plan stays on this device.</p>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<script>
  const previewStatus = document.querySelector<HTMLElement>('[data-home-preview-status]');
  try {
    const rawPlan = localStorage.getItem('cooked-finance-home-plan-v1');
    const parsedPlan = rawPlan ? JSON.parse(rawPlan) : null;
    const savedItems = Array.isArray(parsedPlan?.items) ? parsedPlan.items : [];
    if (previewStatus && savedItems.length > 0) {
      const today = new Date();
      today.setHours(12, 0, 0, 0);
      const dueSoon = savedItems.filter((item: { nextDueDate?: string }) => {
        if (!item.nextDueDate) return false;
        const date = new Date(`${item.nextDueDate}T12:00:00`);
        const days = Math.ceil((date.getTime() - today.getTime()) / 86_400_000);
        return Number.isFinite(days) && days <= 30;
      }).length;
      previewStatus.textContent = dueSoon > 0
        ? `${dueSoon} ${dueSoon === 1 ? 'task' : 'tasks'} due within 30 days`
        : `${savedItems.length} saved ${savedItems.length === 1 ? 'item' : 'items'}`;
    }
  } catch {
    // The example remains useful when local storage is unavailable.
  }
</script>

<style>
  .cost-hero { position: relative; isolation: isolate; overflow: clip; padding: clamp(1.4rem, 4vw, 3rem) 0 clamp(4rem, 9vw, 7rem); }
  .cost-hero__frame { position: relative; z-index: 1; }
  .cost-hero__frame::before { content: ''; position: absolute; inset: 2.5rem 0 0; z-index: -1; border: 1px solid rgba(139, 124, 105, 0.5); background: rgba(255,253,248,0.42); clip-path: polygon(0 0, 96% 0, 100% 7%, 100% 100%, 0 100%); }
  .cost-hero__register { height: 2.5rem; display: flex; align-items: center; justify-content: space-between; padding-inline: 0.9rem; border-bottom: 1px solid var(--color-hairline-strong); color: var(--color-mute); font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.1em; }
  .cost-hero__grid { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(24rem, 0.74fr); align-items: start; gap: clamp(2.5rem, 7vw, 6rem); padding: clamp(2rem, 6vw, 5rem); }
  .cost-hero__copy { padding-top: clamp(1rem, 5vw, 4rem); }
  .cost-hero__copy h1 { max-width: 11.5ch; margin: 0.8rem 0 0; font-family: var(--font-serif); font-size: clamp(3.1rem, 6.8vw, 6.2rem); font-weight: 500; letter-spacing: -0.06em; line-height: 0.9; }
  .cost-hero__lead { max-width: 50ch; margin: 1.4rem 0 0; color: var(--color-body); font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.65; }
  .cost-hero__actions { margin-top: 1.75rem; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .cost-hero__trust { margin: 1.5rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.55rem 1rem; list-style: none; color: var(--color-mute); font-family: var(--font-mono); font-size: 0.7rem; }
  .cost-hero__trust li::before { content: '✓'; margin-right: 0.35rem; color: var(--color-sage); font-family: var(--font-sans); font-weight: 800; }
  .cost-hero__instrument { position: relative; padding-top: 1.5rem; }
  .cost-hero__instrument::before { content: ''; position: absolute; inset: 0.55rem -0.65rem -0.65rem 0.65rem; z-index: -1; background: var(--color-amber); clip-path: polygon(0.7rem 0, 100% 0, 100% calc(100% - 0.7rem), calc(100% - 0.7rem) 100%, 0 100%, 0 0.7rem); }
  .cost-hero__instrument-label { position: absolute; inset: 0 auto auto 1rem; z-index: 2; padding: 0.45rem 0.8rem; background: var(--color-ink); color: var(--color-paper); font-family: var(--font-mono); font-size: 0.62rem; font-weight: 720; letter-spacing: 0.08em; text-transform: uppercase; }
  .systems-head { max-width: none; display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; }
  .home-systems { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1rem; }
  .home-system { grid-column: span 3; min-height: 22rem; padding: 1.25rem; display: flex; flex-direction: column; gap: 1.4rem; color: var(--color-ink); text-decoration: none; transition: transform 180ms var(--ease-out-expo), border-color 180ms ease, box-shadow 180ms ease; }
  .home-system--featured { grid-column: span 6; min-height: 25rem; flex-direction: row; align-items: center; padding: clamp(1.4rem, 3vw, 2rem); }
  .home-system:hover, .home-system:focus-visible { transform: translate(-3px, -3px); border-color: var(--color-ink); box-shadow: 7px 7px 0 var(--color-ink); }
  .home-system__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .home-system--featured .home-system__top { flex-direction: column; }
  .home-system__top > span { color: var(--color-ember-deep); font-family: var(--font-mono); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
  .home-system__copy { min-width: 0; display: flex; flex: 1; flex-direction: column; }
  .home-system h3 { margin: 0; font-family: var(--font-serif); font-size: clamp(1.65rem, 3vw, 2.5rem); font-weight: 500; }
  .home-system p { display: -webkit-box; margin: 0.6rem 0 1rem; overflow: hidden; color: var(--color-body); font-size: 0.82rem; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .home-system b { margin-top: auto; padding-top: 1.2rem; color: var(--color-link); font-size: 0.8rem; }
  .home-loop { border-block: 1px solid var(--color-hairline); background: var(--color-ink); color: var(--color-paper); }
  .home-loop .eyebrow { color: var(--color-amber); }
  .home-loop__grid { display: grid; grid-template-columns: minmax(0, 0.82fr) minmax(24rem, 0.78fr); gap: 2rem 6rem; align-items: center; }
  .home-loop p, .home-loop li { color: rgba(255,253,248,0.72); line-height: 1.65; }
  .home-loop__grid > div:first-child > p { max-width: 52ch; margin: 1.25rem 0 1.5rem; }
  .home-loop .btn-primary { background: var(--color-paper); color: var(--color-ink); }
  .home-loop__board { overflow: hidden; border: 1px solid rgba(255,253,248,0.32); border-radius: var(--radius-sm); background: #24211b; box-shadow: 6px 6px 0 var(--color-ember); }
  .home-loop__board-head { min-height: 48px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.7rem 1rem; border-bottom: 1px solid rgba(255,253,248,0.18); font-family: var(--font-mono); font-size: 0.64rem; text-transform: uppercase; }
  .home-loop__board-head b { color: var(--color-amber); font-weight: 650; }
  .home-loop__board ol { margin: 0; padding: 0; list-style: none; }
  .home-loop__board li { min-height: 74px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.9rem; padding: 0.8rem 1rem; border-bottom: 1px solid rgba(255,253,248,0.12); }
  .home-loop__board li::before { content: none; }
  .home-loop__board li b, .home-loop__board li small { display: block; }
  .home-loop__board li b { color: var(--color-paper); font-size: 0.86rem; }
  .home-loop__board li small, .home-loop__board time { color: rgba(255,253,248,0.56); font-size: 0.68rem; }
  .home-loop__board time { font-family: var(--font-mono); }
  .home-loop__state { min-width: 3.1rem; padding: 0.3rem 0.4rem; border: 1px solid currentColor; border-radius: var(--radius-pill); font-family: var(--font-mono); font-size: 0.58rem; text-align: center; text-transform: uppercase; }
  .home-loop__state--due { color: #f18b6f; }
  .home-loop__state--soon { color: var(--color-amber); }
  .home-loop__state--later { color: #8fc4ae; }
  .home-loop__board > p { margin: 0; padding: 0.8rem 1rem; color: rgba(255,253,248,0.48); font-family: var(--font-mono); font-size: 0.62rem; }
  @media (max-width: 960px) {
    .cost-hero__grid { grid-template-columns: 1fr; align-items: start; }
    .cost-hero__copy h1 { max-width: 13ch; }
    .home-system, .home-system--featured { grid-column: span 6; min-height: 21rem; flex-direction: column; align-items: stretch; }
    .home-system--featured .home-system__top { flex-direction: row; }
    .home-loop__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .cost-hero__grid { padding-inline: 1.25rem; }
  }
  @media (max-width: 520px) {
    .cost-hero__copy h1 { font-size: clamp(3rem, 15vw, 4.6rem); }
    .cost-hero__actions { align-items: stretch; flex-direction: column; }
    .systems-head { align-items: stretch; flex-direction: column; }
    .home-system, .home-system--featured { grid-column: 1 / -1; min-height: 19rem; }
    .home-loop__board li { grid-template-columns: auto 1fr; }
    .home-loop__board time { grid-column: 2; }
  }
</style>
