---
import PageLayout from '../layouts/PageLayout.astro';
import ContentNote from '../components/content/ContentNote.astro';
import EvidenceTable from '../components/content/EvidenceTable.astro';
import RelatedReading from '../components/content/RelatedReading.astro';
import { HOME_ENERGY_COST_ASSUMPTIONS, REPAIR_VS_REPLACE_ASSUMPTIONS } from '../lib/home-cost';
---

<PageLayout
  title="Home Cost Methodology & Assumptions | Cooked Finance"
  description="How Cooked Finance calculates home energy costs and repair-versus-replace scenarios, chooses sources, handles uncertainty, and avoids double counting."
  path="/methodology/"
  eyebrow="Open methodology"
  heading="Every home-cost result should be inspectable."
  lead="The tools use small, deterministic formulas. The hard part is defining the input correctly, showing what was excluded, and refusing to turn an estimate into a prediction."
  updated="August 31, 2026"
>
  <ContentNote title="Educational estimates, not inspections" tone="caution">
    <p>Cooked Finance does not inspect equipment, diagnose faults, predict breakdowns, or replace a product manual or qualified professional. Cost never overrides a recall, hazard, or safety instruction.</p>
  </ContentNote>

  <h2>Running-cost formula</h2>
  <p><strong>Annual electricity cost = annual kWh × electricity price per kWh.</strong></p>
  <p><strong>Annual natural-gas cost = annual therms × gas price per therm.</strong></p>
  <p>The displayed monthly value is the annual total divided by 12. It is an average, not a prediction of a particular seasonal bill.</p>

  <EvidenceTable caption="Inputs accepted by the running-cost calculator">
    <thead><tr><th scope="col">Input</th><th scope="col">Preferred source</th><th scope="col">Important limitation</th></tr></thead>
    <tbody>
      <tr><th scope="row">Annual kWh</th><td>Exact-model EnergyGuide, ENERGY STAR record, utility bill, or measured use</td><td>A standardized label is not actual household consumption.</td></tr>
      <tr><th scope="row">Electricity rate</th><td>Your utility bill</td><td>Fixed fees, tiers, taxes, and seasonal prices may not be captured by one rate.</td></tr>
      <tr><th scope="row">Annual therms</th><td>Your utility bill or a properly scoped estimate</td><td>Whole-home gas use should not be attributed to one appliance without support.</td></tr>
      <tr><th scope="row">Gas rate</th><td>Your utility bill</td><td>Delivery charges and fixed fees may be separate.</td></tr>
    </tbody>
  </EvidenceTable>

  <h3>Calculation assumptions</h3>
  <ul>{HOME_ENERGY_COST_ASSUMPTIONS.map((assumption) => <li>{assumption}</li>)}</ul>

  <h2>Repair-versus-replace formula</h2>
  <p><strong>Repair scenario = repair quote + current annual operating cost × planning years.</strong></p>
  <p><strong>Replacement scenario = installed replacement price + replacement annual operating cost × planning years.</strong></p>
  <p>Modeled replacement savings are the repair-scenario total minus the replacement-scenario total. A positive number means replacement is less expensive within the entered scenario.</p>

  <h3>Scenario assumptions</h3>
  <ul>{REPAIR_VS_REPLACE_ASSUMPTIONS.map((assumption) => <li>{assumption}</li>)}</ul>

  <h2>Double-counting rules</h2>
  <p>Some federal test procedures include energy outside the appliance itself. In particular, standardized dishwasher and clothes-washer annual kWh can include modeled hot-water energy. Adding either unchanged to a complete water-heater annual estimate can count the same energy twice.</p>
  <p>We therefore describe what the standardized metric includes on each system page and avoid silently combining overlapping estimates.</p>

  <h2>Source hierarchy</h2>
  <ol>
    <li>Federal safety, test-procedure, label, and certified-product sources.</li>
    <li>Government extension and public-service guidance.</li>
    <li>The exact product manual for model-specific maintenance.</li>
    <li>Manufacturer-neutral technical material when a primary source is unavailable.</li>
  </ol>
  <p>Each system page lists the sources used and a substantive review date. We do not derive annual kWh directly from CEER, CEF, UEF, IEF, or another efficiency ratio without the additional test inputs required to do so.</p>

  <h2>What the tools deliberately omit</h2>
  <ul>
    <li>Failure probability and remaining service life.</li>
    <li>Financing, discount rates, future inflation, rebates, taxes, resale value, and future repairs.</li>
    <li>Safety, comfort, noise, downtime, parts availability, and repair quality.</li>
    <li>Guaranteed savings, payback, or durability from ENERGY STAR certification.</li>
  </ul>

  <h2>Version history</h2>
  <EvidenceTable caption="Home-cost model change log">
    <thead><tr><th scope="col">Version</th><th scope="col">Date</th><th scope="col">Material change</th></tr></thead>
    <tbody><tr><th scope="row">1.0.0</th><td>August 31, 2026</td><td>Introduced electricity, optional natural-gas, and repair-versus-replace scenario engines with explicit warnings and assumptions.</td></tr></tbody>
  </EvidenceTable>

  <RelatedReading links={[
    { href: '/source-policy/', label: 'Source policy', description: 'How evidence is selected, cited, reviewed, and corrected.' },
    { href: '/systems/', label: 'System guides', description: 'See the metric and source panel for each initial appliance.' },
    { href: '/tools/', label: 'Home cost tools', description: 'Use the formulas with your own figures.' },
  ]} />
</PageLayout>
