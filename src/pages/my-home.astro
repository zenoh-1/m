---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MyHomeManager from '../components/home/MyHomeManager.astro';
---

<Layout
  title="Private Home Maintenance Planner | Cooked Finance"
  description="Save appliance and home-system maintenance dates locally, then export a private JSON backup or calendar file. No account required."
  path="/my-home/"
  noindex={true}
>
  <SiteHeader />
  <main id="main-content" class="my-home-page">
    <div class="container-page">
      <nav class="my-home-page__crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">My Home</span></nav>
      <header class="my-home-page__head">
        <span class="eyebrow">Private workspace</span>
        <h1>Build a home plan you control.</h1>
        <p>Track the next useful date without opening an account. Everything stays in this browser unless you choose to export it.</p>
      </header>
      <MyHomeManager />
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
  .my-home-page { padding: clamp(1.8rem, 5vw, 4rem) 0 var(--section-space); }
  .my-home-page__crumbs { display: flex; gap: 0.4rem; color: var(--color-mute); font-size: 0.76rem; }
  .my-home-page__crumbs a { color: var(--color-body); text-underline-offset: 0.16em; }
  .my-home-page__head { max-width: 820px; padding: clamp(2rem, 6vw, 4.5rem) 0 1rem; }
  .my-home-page__head h1 { max-width: 13ch; margin: 0.7rem 0 0; font-family: var(--font-serif); font-size: clamp(3rem, 8vw, 6rem); font-weight: 500; letter-spacing: -0.055em; line-height: 0.94; }
  .my-home-page__head p { max-width: 58ch; margin: 1.15rem 0 0; color: var(--color-body); font-size: 1.05rem; line-height: 1.7; }
</style>
