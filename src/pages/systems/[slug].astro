---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import EnergyCostTool from '../../components/home/EnergyCostTool.astro';
import GuideNavigator from '../../components/GuideNavigator.astro';
import SystemSignal from '../../components/SystemSignal.astro';
import AmbientHomeScene from '../../components/AmbientHomeScene.astro';
import { HOME_SYSTEMS, type HomeSystem } from '../../data/homeSystems';
import { SITE } from '../../lib/seo';

export function getStaticPaths() {
  return HOME_SYSTEMS.map((system) => ({ params: { slug: system.slug }, props: { system } }));
}

interface Props { system: HomeSystem; }
const { system } = Astro.props;
const path = `/systems/${system.slug}/`;
const systemIndex = HOME_SYSTEMS.findIndex((candidate) => candidate.slug === system.slug) + 1;
const relatedSystems = HOME_SYSTEMS
  .filter((candidate) => candidate.slug !== system.slug)
  .sort((a, b) => Number(b.category === system.category) - Number(a.category === system.category))
  .slice(0, 3);
const reviewedDisplay = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(new Date(`${system.reviewedAt}T00:00:00Z`));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Systems', item: `${SITE.url}/systems/` },
      { '@type': 'ListItem', position: 3, name: system.name, item: `${SITE.url}${path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: system.title,
    description: system.description,
    datePublished: '2026-08-31',
    dateModified: system.reviewedAt,
    inLanguage: 'en-US',
    mainEntityOfPage: `${SITE.url}${path}`,
    author: { '@type': 'Organization', name: SITE.name, url: `${SITE.url}/about/` },
    publisher: { '@id': `${SITE.url}/#organization` },
  },
];
---

<Layout
  title={`${system.title} | Cooked Finance`}
  description={system.description}
  path={path}
  type="article"
  jsonLd={jsonLd}
>
  <SiteHeader />
  <main id="main-content" class="system-page">
    <AmbientHomeScene variant="guide" eager={true} />
    <div class="container-page">
      <nav class="system-page__crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/systems/">Systems</a><span aria-hidden="true">/</span><span aria-current="page">{system.name}</span></nav>

      <header class="system-hero">
        <div data-reveal>
          <span class="eyebrow">{system.category} · Home system guide</span>
          <h1>{system.title}</h1>
          <p>{system.summary}</p>
          <div class="system-hero__meta"><span>Sources reviewed <time datetime={system.reviewedAt}>{reviewedDisplay}</time></span><span>U.S. source set</span><span>Educational estimate</span></div>
        </div>
        <div class="system-hero__instrument" data-reveal>
          <SystemSignal label={system.shortName} category={system.category} index={systemIndex} />
          <aside class="system-input-card" aria-labelledby="input-card-title">
            <span>Best starting input</span>
            <h2 id="input-card-title">{system.energyInput}</h2>
            <p>{system.energyInputHelp}</p>
            <small>{system.labelNote}</small>
          </aside>
        </div>
      </header>

      <GuideNavigator systemName={system.shortName} />

      <section class="system-section" id="guide-cost" data-guide-section aria-labelledby="cost-section-title">
        <div class="system-section__head">
          <span class="eyebrow">01 · Cost to run</span>
          <h2 id="cost-section-title">Replace the example with your {system.shortName.toLowerCase()} data.</h2>
          <p>The calculator begins with an obvious example so you can see the method. Your exact model and utility rate produce the useful result.</p>
        </div>
        {system.accountingNote && <div class="system-accounting"><strong>Avoid double counting</strong><p>{system.accountingNote}</p></div>}
        <EnergyCostTool />
      </section>

      <section class="system-section" id="guide-care" data-guide-section aria-labelledby="care-section-title">
        <div class="system-section__head">
          <span class="eyebrow">02 · Care plan</span>
          <h2 id="care-section-title">A short routine with clear boundaries.</h2>
          <p>Always follow the exact model manual when it gives a different instruction or schedule.</p>
        </div>
        <ol class="care-grid">
          {system.careTasks.map((task, index) => (
            <li class="card">
              <div><span>{String(index + 1).padStart(2, '0')}</span><b>{task.cadence}</b></div>
              <h3>{task.title}</h3>
              <p>{task.detail}</p>
              <a href={`/my-home/?system=${system.slug}&task=${index}`}>Plan This Task →</a>
            </li>
          ))}
        </ol>
        <a class="btn-secondary care-save" href="/my-home/">Add a Date to My Home</a>
      </section>

      <section class="safety-panel" id="guide-safety" data-guide-section aria-labelledby="safety-title">
        <div>
          <span class="eyebrow">Stop and make it safe</span>
          <h2 id="safety-title">Cost never outranks a hazard.</h2>
          <p>Stop using the equipment and seek qualified help for smoke, burning odor, sparking, shock or tingling, damaged plugs or outlets, recurring breaker trips, or water reaching electrical parts.</p>
        </div>
        <ul>{system.redFlags.map((flag) => <li>{flag}</li>)}</ul>
      </section>

      <section class="system-section system-section--decision" id="guide-decision" data-guide-section aria-labelledby="decision-section-title">
        <div class="system-section__head">
          <span class="eyebrow">03 · Repair or replace</span>
          <h2 id="decision-section-title">Put the quote and the replacement on one timeline.</h2>
          <p>The scenario tool compares price and operating cost. It deliberately does not predict failure or remaining service life.</p>
        </div>
        <a class="btn-primary" href="/tools/repair-or-replace/">Open Repair or Replace Scenario</a>
      </section>

      <section class="source-panel" id="guide-sources" data-guide-section aria-labelledby="source-title">
        <div><span class="eyebrow">Evidence panel</span><h2 id="source-title">Sources used for this guide</h2><p>Official and extension sources are shown directly so assumptions can be checked.</p></div>
        <ul>
          {system.sources.map((source, index) => (
            <li><b aria-hidden="true">{String(index + 1).padStart(2, '0')}</b><span>{source.publisher}</span><a href={source.url} rel="noopener" target="_blank">{source.label}<span class="sr-only"> (opens in a new tab)</span></a></li>
          ))}
        </ul>
      </section>

      <section class="related-systems" id="guide-related" data-guide-section aria-labelledby="related-title">
        <span class="eyebrow">Continue through the home</span>
        <h2 id="related-title">Related system guides</h2>
        <div class="content-cards">
          {relatedSystems.map((related) => (
            <a class="content-card card" href={`/systems/${related.slug}/`}>
              <span class="tag">{related.category}</span>
              <h3 class="content-card__title">{related.shortName}</h3>
              <p class="content-card__copy">{related.description}</p>
              <span class="content-card__link">Open guide →</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
  .system-page { position: relative; isolation: isolate; overflow: clip; padding: clamp(1.8rem, 5vw, 4rem) 0 var(--section-space); }
  .system-page > .container-page { position: relative; z-index: 1; }
  .system-page__crumbs { display: flex; flex-wrap: wrap; gap: 0.4rem; color: var(--color-mute); font-size: 0.76rem; }
  .system-page__crumbs a { color: var(--color-body); text-underline-offset: 0.16em; }
  .system-hero { padding: clamp(2.2rem, 7vw, 5.5rem) 0 clamp(3rem, 7vw, 5.5rem); display: grid; grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.52fr); gap: clamp(2rem, 7vw, 6rem); align-items: center; }
  .system-hero h1 { max-width: 14ch; margin: 0.75rem 0 0; font-family: var(--font-serif); font-size: clamp(3rem, 7vw, 5.7rem); font-weight: 500; letter-spacing: -0.055em; line-height: 0.92; }
  .system-hero > div > p { max-width: 60ch; margin: 1.2rem 0 0; color: var(--color-body); font-size: 1.05rem; line-height: 1.7; }
  .system-hero__meta { margin-top: 1.2rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; color: var(--color-mute); font-family: var(--font-mono); font-size: 0.68rem; }
  .system-hero__meta span::before { content: '✓'; margin-right: 0.35rem; color: var(--color-sage); font-family: var(--font-sans); font-weight: 800; }
  .system-hero__instrument { position: relative; display: grid; justify-items: center; padding-top: 1rem; }
  .system-hero__instrument :global(.system-signal) { margin-bottom: -2.2rem; z-index: 2; background-color: var(--color-canvas); }
  .system-input-card { position: relative; z-index: 1; width: 100%; padding: 3.6rem 1.4rem 1.4rem; border: 1px solid var(--color-ink); border-radius: var(--radius-sm); background: var(--color-paper); box-shadow: 5px 5px 0 var(--color-amber); }
  .system-input-card > span { color: var(--color-ember-deep); font-family: var(--font-mono); font-size: 0.67rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .system-input-card h2 { margin: 1.5rem 0 0; font-family: var(--font-serif); font-size: 1.65rem; font-weight: 500; line-height: 1.12; }
  .system-input-card p { margin: 0.7rem 0 0; color: var(--color-body); line-height: 1.55; }
  .system-input-card small { display: block; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--color-hairline); color: var(--color-mute); line-height: 1.5; }
  .system-section { padding-top: var(--section-space); border-top: 1px solid var(--color-hairline-strong); }
  .system-section + .system-section, .system-section + .safety-panel, .safety-panel + .system-section { margin-top: var(--section-space); }
  .system-section__head { max-width: 790px; margin-bottom: clamp(1.8rem, 5vw, 3rem); }
  .system-section__head h2 { max-width: 18ch; margin: 0.7rem 0 0; font-family: var(--font-serif); font-size: clamp(2.4rem, 5.5vw, 4.2rem); font-weight: 500; letter-spacing: -0.045em; line-height: 1; }
  .system-section__head p { max-width: 60ch; margin: 1rem 0 0; color: var(--color-body); line-height: 1.7; }
  .system-accounting { margin-bottom: 1rem; padding: 1rem 1.15rem; border: 1px solid var(--color-amber); border-radius: var(--radius-md); background: #fff7e8; }
  .system-accounting strong { color: var(--color-ink); }
  .system-accounting p { margin: 0.35rem 0 0; color: var(--color-body); line-height: 1.55; }
  .care-grid { margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; list-style: none; }
  .care-grid li { position: relative; min-height: 18rem; padding: 1.4rem 1.4rem 1.4rem 2rem; overflow: hidden; box-shadow: none; }
  .care-grid li::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 0.55rem; background: repeating-linear-gradient(0deg, var(--color-sage) 0 9px, transparent 9px 14px); }
  .care-grid li > div { display: flex; justify-content: space-between; gap: 1rem; color: var(--color-ember-deep); font-family: var(--font-mono); font-size: 0.67rem; }
  .care-grid li b { max-width: 26ch; text-align: right; }
  .care-grid h3 { margin: 3.2rem 0 0; font-family: var(--font-serif); font-size: 1.65rem; font-weight: 500; }
  .care-grid p { margin: 0.7rem 0 0; color: var(--color-body); line-height: 1.6; }
  .care-grid li > a { display: inline-block; margin-top: 1.2rem; color: var(--color-link); font-size: 0.76rem; font-weight: 720; text-underline-offset: 0.18em; }
  .care-save { margin-top: 1.25rem; }
  .safety-panel { margin-top: var(--section-space); padding: clamp(1.5rem, 5vw, 3rem); display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(18rem, 1fr); gap: 2rem 4rem; border: 1px solid #7d2d1d; border-radius: var(--radius-sm); background: var(--color-ember-deep); color: var(--color-paper); box-shadow: 6px 6px 0 var(--color-ink); }
  .safety-panel .eyebrow { color: #ffd291; }
  .safety-panel h2 { margin: 0.7rem 0 0; font-family: var(--font-serif); font-size: clamp(2.2rem, 5vw, 3.8rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1; }
  .safety-panel p, .safety-panel li { color: rgba(255,252,247,0.72); line-height: 1.65; }
  .safety-panel ul { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.7rem; }
  .system-section--decision { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1.5rem 3rem; }
  .system-section--decision .system-section__head { margin-bottom: 0; }
  .source-panel { margin-top: var(--section-space); padding-top: var(--section-space); display: grid; grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr); gap: 2rem 5rem; border-top: 1px solid var(--color-hairline-strong); }
  .source-panel h2, .related-systems h2 { margin: 0.65rem 0 0; font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3rem); font-weight: 500; letter-spacing: -0.04em; }
  .source-panel p { color: var(--color-body); line-height: 1.65; }
  .source-panel ul { margin: 0; padding: 0; display: grid; list-style: none; border-top: 1px solid var(--color-hairline); }
  .source-panel li { padding: 1rem 0; display: grid; grid-template-columns: 2rem minmax(8rem, 0.5fr) minmax(0, 1fr); gap: 1rem; border-bottom: 1px solid var(--color-hairline); }
  .source-panel li b { color: var(--color-ember-deep); font-family: var(--font-mono); font-size: 0.64rem; }
  .source-panel li span { color: var(--color-mute); font-size: 0.76rem; }
  .source-panel li a { color: var(--color-link); font-weight: 700; text-underline-offset: 0.18em; }
  .related-systems { margin-top: var(--section-space); padding-top: var(--section-space); border-top: 1px solid var(--color-hairline-strong); }
  .related-systems .content-cards { margin-top: 1.5rem; }
  @media (max-width: 820px) {
    .system-hero, .safety-panel, .source-panel { grid-template-columns: 1fr; align-items: start; }
    .system-input-card { max-width: 34rem; }
  }
  @media (max-width: 620px) {
    .care-grid { grid-template-columns: 1fr; }
    .care-grid li { min-height: auto; }
    .care-grid h3 { margin-top: 2rem; }
    .source-panel li { grid-template-columns: 2rem 1fr; gap: 0.35rem 0.75rem; }
    .source-panel li a { grid-column: 2; }
  }
</style>
