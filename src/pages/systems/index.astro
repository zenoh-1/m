---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SystemSignal from '../../components/SystemSignal.astro';
import { HOME_SYSTEMS } from '../../data/homeSystems';
const categories = ['All', ...new Set(HOME_SYSTEMS.map((system) => system.category))];
---

<Layout
  title="Appliance Running Cost & Care Guides | Cooked Finance"
  description="Browse source-backed running-cost and maintenance guides for refrigerators, washers, dryers, dishwashers, water heaters, room ACs, and more."
  path="/systems/"
>
  <SiteHeader />
  <main id="main-content" class="systems-page">
    <div class="container-page">
      <nav class="systems-page__crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Systems</span></nav>
      <header class="systems-page__head">
        <div class="systems-page__register"><span>CATALOG / 8 SYSTEMS</span><span>SOURCE-BACKED</span></div>
        <span class="eyebrow">8 useful starting points</span>
        <h1>What does this thing cost—and what should I do next?</h1>
        <p>Choose the equipment in your home. Each guide starts with the exact label metric, separates standardized estimates from real use, and draws a firm line around unsafe work.</p>
      </header>

      <form class="system-finder" data-system-finder hidden role="search">
        <div class="system-finder__search">
          <label for="system-search">Find a Home System</label>
          <div>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="4.8" stroke="currentColor" stroke-width="1.5" /><path d="m11.5 11.5 3.2 3.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
            <input id="system-search" name="q" type="search" autocomplete="off" placeholder="Refrigerator, laundry, or kWh…" data-system-search />
            <button type="button" data-system-clear>Clear</button>
          </div>
        </div>
        <div class="system-finder__categories" role="group" aria-label="Filter by category">
          {categories.map((category, index) => (
            <button type="button" data-system-category={category.toLowerCase().replace(/\s+/g, '-')} aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>
          ))}
        </div>
        <p data-system-count role="status" aria-live="polite">Showing all 8 systems</p>
      </form>

      <div class="systems-grid">
        {HOME_SYSTEMS.map((system, index) => (
          <a
            class="system-card card"
            href={`/systems/${system.slug}/`}
            data-system-card
            data-category={system.category.toLowerCase().replace(/\s+/g, '-')}
            data-search={`${system.name} ${system.shortName} ${system.category} ${system.summary} ${system.energyInput}`.toLowerCase()}
          >
            <div class="system-card__meta"><span>Manual {String(index + 1).padStart(2, '0')}</span><span>{system.category}</span></div>
            <div class="system-card__main">
              <div><h2>{system.shortName}</h2><p>{system.summary}</p></div>
              <SystemSignal label={system.shortName} category={system.category} index={index + 1} />
            </div>
            <div class="system-card__foot"><span class="manual-tag">{system.energyInput}</span><b>Open Guide →</b></div>
          </a>
        ))}
      </div>

      <div class="system-finder__empty card" data-system-empty hidden>
        <span aria-hidden="true">0</span><div><h2>No matching system yet</h2><p>Try a broader term or clear the category filter. The catalog will expand as new guides are researched.</p></div>
      </div>

      <aside class="systems-page__method">
        <div><span>Not a model-number database</span><strong>Use the exact label or official product record whenever possible.</strong></div>
        <p>We do not infer annual kWh from an efficiency ratio or publish a generic “typical” cost as if it were your bill.</p>
        <a class="btn-secondary" href="/methodology/">Read the Home Cost Methodology</a>
      </aside>
    </div>
  </main>
  <SiteFooter />
</Layout>

<script>
  const finder = document.querySelector<HTMLFormElement>('[data-system-finder]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-system-card]')];
  const search = finder?.querySelector<HTMLInputElement>('[data-system-search]');
  const categoryButtons = [...(finder?.querySelectorAll<HTMLButtonElement>('[data-system-category]') ?? [])];
  const count = finder?.querySelector<HTMLElement>('[data-system-count]');
  const empty = document.querySelector<HTMLElement>('[data-system-empty]');
  let activeCategory = 'all';

  const applyFilters = (updateUrl = true) => {
    const query = search?.value.trim().toLowerCase() ?? '';
    let visibleCount = 0;
    cards.forEach((card) => {
      const matchesQuery = !query || (card.dataset.search ?? '').includes(query);
      const matchesCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
      card.hidden = !(matchesQuery && matchesCategory);
      if (!card.hidden) visibleCount += 1;
    });
    if (count) count.textContent = visibleCount === cards.length
      ? `Showing all ${cards.length} systems`
      : `Showing ${visibleCount} of ${cards.length} systems`;
    if (empty) empty.hidden = visibleCount !== 0;

    if (updateUrl) {
      const url = new URL(window.location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      if (activeCategory !== 'all') url.searchParams.set('category', activeCategory);
      else url.searchParams.delete('category');
      history.replaceState({}, '', url);
    }
  };

  if (finder && search) {
    finder.hidden = false;
    const params = new URLSearchParams(window.location.search);
    search.value = params.get('q') ?? '';
    const requestedCategory = params.get('category') ?? 'all';
    if (categoryButtons.some((button) => button.dataset.systemCategory === requestedCategory)) activeCategory = requestedCategory;
    categoryButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.systemCategory === activeCategory)));
    applyFilters(false);

    search.addEventListener('input', () => applyFilters());
    categoryButtons.forEach((button) => button.addEventListener('click', () => {
      activeCategory = button.dataset.systemCategory ?? 'all';
      categoryButtons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
      applyFilters();
    }));
    finder.querySelector<HTMLButtonElement>('[data-system-clear]')?.addEventListener('click', () => {
      search.value = '';
      activeCategory = 'all';
      categoryButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.systemCategory === 'all')));
      applyFilters();
      search.focus();
    });
  }
</script>

<style>
  .systems-page { padding: clamp(1.8rem, 5vw, 4rem) 0 var(--section-space); }
  .systems-page__crumbs { display: flex; gap: 0.4rem; color: var(--color-mute); font-size: 0.76rem; }
  .systems-page__crumbs a { color: var(--color-body); text-underline-offset: 0.16em; }
  .systems-page__head { max-width: 1040px; padding: clamp(2rem, 6vw, 5rem) 0 clamp(2.5rem, 6vw, 4.5rem); }
  .systems-page__register { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: clamp(2rem, 6vw, 4rem); padding: 0.7rem 0; border-block: 1px solid var(--color-hairline-strong); color: var(--color-mute); font-family: var(--font-mono); font-size: 0.61rem; letter-spacing: 0.08em; }
  .systems-page__head h1 { max-width: 16ch; margin: 0.75rem 0 0; font-family: var(--font-serif); font-size: clamp(3rem, 7.5vw, 6rem); font-weight: 500; letter-spacing: -0.055em; line-height: 0.94; }
  .systems-page__head p { max-width: 65ch; margin: 1.2rem 0 0; color: var(--color-body); font-size: 1.06rem; line-height: 1.7; }
  .system-finder { margin-bottom: 1.25rem; padding: clamp(1rem, 3vw, 1.5rem); display: grid; grid-template-columns: minmax(16rem, 0.78fr) minmax(0, 1.22fr); gap: 1rem 2rem; border: 1px solid var(--color-ink); border-radius: var(--radius-sm); background: var(--color-paper); box-shadow: 4px 4px 0 var(--color-ink); }
  .system-finder__search label { display: block; margin-bottom: 0.45rem; font-size: 0.78rem; font-weight: 720; }
  .system-finder__search > div { min-height: 50px; display: flex; align-items: center; gap: 0.65rem; padding: 0.25rem 0.35rem 0.25rem 0.8rem; border: 1px solid var(--color-hairline-strong); border-radius: var(--radius-xs); background: #fff; }
  .system-finder__search > div:focus-within { border-color: var(--color-ember); box-shadow: 0 0 0 3px rgba(183,71,41,0.14); }
  .system-finder__search svg { flex: 0 0 auto; color: var(--color-mute); }
  .system-finder__search input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: var(--color-ink); }
  .system-finder__search button { min-height: 44px; padding: 0.45rem 0.7rem; border: 0; border-radius: var(--radius-xs); background: var(--color-surface-2); color: var(--color-body); font-size: 0.72rem; font-weight: 680; }
  .system-finder__categories { align-self: end; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .system-finder__categories button { min-height: 44px; padding: 0.5rem 0.8rem; border: 1px solid var(--color-hairline-strong); border-radius: var(--radius-pill); background: transparent; color: var(--color-body); font-size: 0.72rem; font-weight: 680; }
  .system-finder__categories button:hover, .system-finder__categories button[aria-pressed='true'] { border-color: var(--color-ink); background: var(--color-ink); color: var(--color-paper); }
  .system-finder > p { grid-column: 1 / -1; margin: 0; color: var(--color-mute); font-family: var(--font-mono); font-size: 0.66rem; }
  .systems-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .system-card { min-height: 21rem; display: flex; flex-direction: column; padding: clamp(1.25rem, 3vw, 1.8rem); color: var(--color-ink); text-decoration: none; transition: transform 180ms var(--ease-out-expo), border-color 180ms ease, box-shadow 180ms ease; }
  .system-card:hover, .system-card:focus-visible { transform: translate(-3px, -3px); border-color: var(--color-ink); box-shadow: 7px 7px 0 var(--color-ink); }
  .system-card[hidden] { display: none; }
  .system-card__meta { display: flex; justify-content: space-between; gap: 1rem; color: var(--color-ember-deep); font-family: var(--font-mono); font-size: 0.67rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .system-card__main { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 1.5rem; margin-top: 1.4rem; }
  .system-card h2 { margin: 0; font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3rem); font-weight: 500; letter-spacing: -0.04em; }
  .system-card p { max-width: 58ch; margin: 0.8rem 0 0; color: var(--color-body); line-height: 1.65; }
  .system-card__foot { margin-top: auto; padding-top: 1.2rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--color-hairline); color: var(--color-mute); font-size: 0.76rem; }
  .system-card__foot span { max-width: 35ch; }
  .system-card__foot b { flex: 0 0 auto; color: var(--color-link); }
  .system-finder__empty { margin-top: 1rem; padding: 1.5rem; display: flex; align-items: center; gap: 1.5rem; box-shadow: none; }
  .system-finder__empty[hidden] { display: none; }
  .system-finder__empty > span { width: 4rem; height: 4rem; display: grid; place-items: center; border: 1px dashed var(--color-hairline-strong); border-radius: 50%; color: var(--color-mute); font-family: var(--font-serif); font-size: 2rem; }
  .system-finder__empty h2, .system-finder__empty p { margin: 0; }
  .system-finder__empty h2 { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 500; }
  .system-finder__empty p { margin-top: 0.35rem; color: var(--color-body); }
  .systems-page__method { margin-top: clamp(2.5rem, 6vw, 5rem); padding: clamp(1.4rem, 4vw, 2.2rem); display: grid; grid-template-columns: 1fr 1fr auto; gap: 1rem 2rem; align-items: center; border: 1px solid var(--color-hairline); border-radius: var(--radius-lg); background: var(--color-ink); color: var(--color-paper); }
  .systems-page__method span { display: block; color: var(--color-amber); font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .systems-page__method strong { display: block; margin-top: 0.4rem; max-width: 32ch; font-family: var(--font-serif); font-size: 1.4rem; font-weight: 500; line-height: 1.2; }
  .systems-page__method p { margin: 0; color: rgba(255,252,247,0.7); line-height: 1.6; }
  .systems-page__method .btn-secondary { background: var(--color-paper); }
  @media (max-width: 850px) {
    .system-finder { grid-template-columns: 1fr; }
    .system-finder > p { grid-column: auto; }
    .system-card__main { grid-template-columns: 1fr; }
    .system-card__main :global(.system-signal) { order: -1; }
    .systems-page__method { grid-template-columns: 1fr; align-items: start; }
    .systems-page__method .btn-secondary { width: fit-content; }
  }
  @media (max-width: 680px) {
    .systems-grid { grid-template-columns: 1fr; }
    .system-card { min-height: 19rem; }
    .system-card__main { grid-template-columns: minmax(0, 1fr) auto; }
    .system-card__main :global(.system-signal) { order: initial; }
  }
  @media (max-width: 460px) {
    .system-card__main { grid-template-columns: 1fr; }
    .system-card__main :global(.system-signal) { order: -1; }
    .system-card__foot { align-items: flex-start; flex-direction: column; }
  }
</style>
