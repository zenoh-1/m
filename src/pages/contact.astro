---
import PageLayout from '../layouts/PageLayout.astro';

const email = 'hello@cookedfinance.com';
---

<PageLayout
  title="Contact Us | Cooked Finance"
  description="Get in touch with the Cooked Finance team. Questions, feedback, partnership ideas, or press — we'd love to hear from you."
  path="/contact"
  eyebrow="Contact"
  heading="Get in touch."
  lead="Send a correction, source update, bug report, accessibility issue, or general question."
  updated="August 31, 2026"
>
  <h2>Email us</h2>
  <p>
    The most direct way to reach us is by email at
    <a href={`mailto:${email}`}>{email}</a>.
  </p>

  <h2>Send a message</h2>
  <p>
    Prefer a form? Fill this out and your email app will open with everything
    ready to send. The form itself does not submit anything to Cooked Finance.
  </p>

  <form id="contact-form" class="card contact-form" aria-label="Contact Cooked Finance" novalidate>
    <div class="contact-field">
      <label class="contact-label" for="name">Name</label>
      <input class="field-input" id="name" name="name" type="text" autocomplete="name" placeholder="Alex Carter…" required aria-describedby="name-error" />
      <p class="contact-error" id="name-error" data-error-for="name" aria-live="polite"></p>
    </div>

    <div class="contact-field">
      <label class="contact-label" for="email">Email</label>
      <input class="field-input" id="email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="you@example.com…" spellcheck="false" required aria-describedby="email-error" />
      <p class="contact-error" id="email-error" data-error-for="email" aria-live="polite"></p>
    </div>

    <div class="contact-field">
      <label class="contact-label" for="message">Message</label>
      <textarea class="field-input contact-textarea" id="message" name="message" rows="5" autocomplete="off" placeholder="Example: I found a source issue on…" required aria-describedby="message-error"></textarea>
      <p class="contact-error" id="message-error" data-error-for="message" aria-live="polite"></p>
    </div>

    <button type="submit" class="btn-primary contact-submit" data-open-email-draft>
      Open Email Draft
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M2 4.5 8 9l6-4.5M2.5 3.5h11a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </form>

  <h2>Other things</h2>
  <ul>
    <li><strong>Corrections:</strong> include the page URL, disputed passage, and a primary source when possible.</li>
    <li><strong>Privacy questions:</strong> see our <a href="/privacy/">Privacy Policy</a>.</li>
    <li><strong>Terms:</strong> see our <a href="/terms/">Terms &amp; Conditions</a>.</li>
  </ul>
</PageLayout>

<style>
  .contact-form {
    padding: clamp(1.5rem, 4vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1rem;
    /* Override .prose list/anchor flow spacing inside the form. */
  }
  .contact-field { display: flex; flex-direction: column; gap: 0.5rem; }
  .contact-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .contact-textarea {
    height: auto;
    min-height: 120px;
    padding: 0.75rem 0.875rem;
    resize: vertical;
    line-height: 1.5;
    font-family: inherit;
  }
  .field-input { padding-inline: 0.875rem; border-color: var(--color-body); }
  .field-input::placeholder { color: var(--color-body); opacity: 1; }
  .contact-error {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-status-apocalypse);
  }
  .contact-error:empty { display: none; }
  .contact-submit { align-self: flex-start; }
</style>

<script>
  const form = document.getElementById('contact-form');

  function clearContactError(input: HTMLInputElement | HTMLTextAreaElement) {
    input.removeAttribute('aria-invalid');
    const error = document.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
    if (error) error.textContent = '';
  }

  function setContactError(input: HTMLInputElement | HTMLTextAreaElement, message: string) {
    input.setAttribute('aria-invalid', 'true');
    const error = document.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
    if (error) error.textContent = message;
  }

  form?.addEventListener('input', (event) => {
    const input = event.target;
    if (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement) clearContactError(input);
  });

  function openEmailDraft() {
    const nameInput = document.getElementById('name') as HTMLInputElement | null;
    const emailInput = document.getElementById('email') as HTMLInputElement | null;
    const messageInput = document.getElementById('message') as HTMLTextAreaElement | null;
    if (!nameInput || !emailInput || !messageInput) return;

    [nameInput, emailInput, messageInput].forEach(clearContactError);
    const name = nameInput.value.trim();
    const email = emailInput.value.trim();
    const message = messageInput.value.trim();
    let firstInvalid: HTMLInputElement | HTMLTextAreaElement | null = null;

    if (!name) {
      setContactError(nameInput, 'Enter your name.');
      firstInvalid ??= nameInput;
    }
    if (!email) {
      setContactError(emailInput, 'Enter your email address.');
      firstInvalid ??= emailInput;
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setContactError(emailInput, 'Enter a valid email address, such as you@example.com.');
      firstInvalid ??= emailInput;
    }
    if (!message) {
      setContactError(messageInput, 'Enter the message you want to send.');
      firstInvalid ??= messageInput;
    }
    if (firstInvalid) {
      firstInvalid.focus();
      return;
    }

    const subject = encodeURIComponent(`Cooked Finance — message from ${name}`);
    const body = encodeURIComponent(`${message}\n\n— ${name} (${email})`);
    window.location.href = `mailto:hello@cookedfinance.com?subject=${subject}&body=${body}`;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    openEmailDraft();
  });
</script>
