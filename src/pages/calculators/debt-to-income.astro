---
import PageLayout from '../../layouts/PageLayout.astro';
import RelatedCalculators from '../../components/calculators/RelatedCalculators.astro';

const debtFields = [
  { id: 'housing-payment', label: 'Mortgage housing payment', help: 'Required mortgage payment; include taxes and insurance when they are part of the obligation. Exclude rent here.' },
  { id: 'student-payment', label: 'Student-loan payments', help: 'Required monthly payments, not the total balance.' },
  { id: 'auto-payment', label: 'Auto-loan payments', help: 'Required monthly payments for all vehicle loans.' },
  { id: 'card-payment', label: 'Credit-card minimums', help: 'Add the minimum required payment from each card.' },
  { id: 'other-payment', label: 'Other required debt payments', help: 'Personal loans, court-ordered obligations and other recurring debts a lender may count.' },
];
---

<PageLayout
  title="Debt-to-Income Ratio Calculator (Monthly DTI) | Cooked Finance"
  description="Calculate debt-to-income ratio correctly: required monthly debt payments divided by gross monthly income. See an educational payment-load range and formula."
  path="/calculators/debt-to-income/"
  eyebrow="Calculator 02"
  heading="Your debt-to-income ratio, using the standard payment formula."
  lead="Use monthly payments—not total debt balances—and income before taxes. The result describes payment load; it does not predict loan approval."
  updated="August 17, 2026"
>
  <aside class="formula-strip" aria-label="Debt-to-income formula">
    <span>Required monthly debt payments</span>
    <span aria-hidden="true">÷</span>
    <span>Gross monthly income</span>
    <span aria-hidden="true">× 100 =</span>
    <strong>DTI percentage</strong>
  </aside>

  <div id="dti-form" class="calculator card" role="form" aria-label="Debt-to-income calculator">
    <p class="calculator__privacy"><span aria-hidden="true">●</span> Calculated only in this browser tab. No values are saved.</p>

    <div class="primary-field">
      <label for="gross-income">Gross monthly income (USD) <span aria-hidden="true">*</span></label>
      <div class="money-input">
        <span aria-hidden="true">$</span>
        <input
          id="gross-income"
          type="number"
          inputmode="decimal"
          autocomplete="off"
          min="0.01"
          step="0.01"
          required
          placeholder="6000…"
          aria-describedby="gross-income-help gross-income-error"
        />
      </div>
      <small id="gross-income-help">Income before federal, state and payroll taxes. Combine co-borrower income only if you are also combining their debts.</small>
      <span class="field-error" id="gross-income-error" hidden></span>
    </div>

    <fieldset>
      <legend>
        Monthly required debt payments
        <small>Leave a category blank if it does not apply. Blank fields count as $0.</small>
      </legend>
      <div class="field-grid">
        {debtFields.map((field) => (
          <div class="money-field">
            <label for={field.id}>{field.label} (USD)</label>
            <div class="money-input">
              <span aria-hidden="true">$</span>
              <input
                id={field.id}
                type="number"
                inputmode="decimal"
                autocomplete="off"
                min="0"
                step="0.01"
                placeholder="0…"
                aria-describedby={`${field.id}-help ${field.id}-error`}
              />
            </div>
            <small id={`${field.id}-help`}>{field.help}</small>
            <span class="field-error" id={`${field.id}-error`} hidden></span>
          </div>
        ))}
      </div>
    </fieldset>

    <div class="calculator__actions">
      <button class="btn-primary" type="button" data-calculate-dti>Calculate DTI</button>
      <button class="btn-secondary" type="button" data-clear-dti>Clear values</button>
    </div>
  </div>

  <section id="dti-result" class="result" aria-live="polite" aria-atomic="true" tabindex="-1" hidden>
    <header class="result__head">
      <span class="eyebrow">Your monthly DTI</span>
      <h2><output id="dti-output" for="gross-income housing-payment student-payment auto-payment card-payment other-payment">0%</output></h2>
      <p id="dti-interpretation"></p>
    </header>

    <div class="meter" aria-hidden="true">
      <div class="meter__labels"><span>0%</span><span>20%</span><span>35%</span><span>43%</span><span>60%+</span></div>
      <div class="meter__track">
        <span class="meter__segment meter__segment--lower"></span>
        <span class="meter__segment meter__segment--moderate"></span>
        <span class="meter__segment meter__segment--elevated"></span>
        <span class="meter__segment meter__segment--high"></span>
        <span id="dti-marker" class="meter__marker"></span>
      </div>
    </div>

    <div class="result__stats">
      <div><span>Monthly debt payments</span><strong id="monthly-debt-output">$0</strong></div>
      <div><span>Gross monthly income</span><strong id="monthly-income-output">$0</strong></div>
      <div><span>Illustrative range</span><strong id="dti-band-output">—</strong></div>
    </div>
    <p id="dti-worked" class="result__worked"></p>
    <p class="result__caveat">These ranges are educational descriptions of payment load, not lending cutoffs. A lender may include, exclude or calculate obligations differently.</p>
  </section>

  <section class="method" aria-labelledby="dti-method-heading">
    <span class="eyebrow">Method</span>
    <h2 id="dti-method-heading">The balance is not the payment</h2>
    <p>
      Debt-to-income ratio (DTI) is your <strong>required monthly debt payments divided by gross monthly income</strong>.
      If you owe $18,000 on a car but pay $400 a month, the DTI numerator uses $400—not $18,000. This follows the
      <a href="https://www.consumerfinance.gov/ask-cfpb/what-is-a-debt-to-income-ratio-en-1791/" rel="external">Consumer Financial Protection Bureau definition</a>.
    </p>

    <h3>How to read the illustrative bands</h3>
    <table class="band-table">
      <caption>Educational DTI payment-load bands</caption>
      <thead>
        <tr><th scope="col">DTI range</th><th scope="col">Interpretation</th></tr>
      </thead>
      <tbody>
        <tr><th scope="row">Under 20%</th><td>Lower payment load relative to gross income</td></tr>
        <tr><th scope="row">20%–34.9%</th><td>Moderate payment load</td></tr>
        <tr><th scope="row">35%–42.9%</th><td>Elevated payment load</td></tr>
        <tr><th scope="row">43% and above</th><td>High payment load relative to gross income</td></tr>
      </tbody>
    </table>
    <p>
      These labels provide context, not a universal pass/fail rule. Loan type, credit history, assets, reserves,
      housing expense and underwriting method can change a lender’s decision. For an example of those variations, see
      <a href="https://selling-guide.fanniemae.com/sel/b3-6-02/debt-income-ratios" rel="external">Fannie Mae’s current DTI guidance</a>.
    </p>

    <h3>Worked example</h3>
    <p>
      Required monthly debt payments of $1,800 divided by $6,000 of gross monthly income equal 0.30. Multiply by 100
      for a 30% DTI.
    </p>

    <h3>Limitations</h3>
    <ul>
      <li>This is a simplified back-end DTI estimate, not a lender’s underwriting system.</li>
      <li>Rent and everyday costs are excluded, so DTI is not the same as a household budget.</li>
      <li>Lenders may apply special calculations to student loans, variable income and co-signed debt.</li>
      <li>A manageable DTI still does not show emergency savings, net worth or income stability.</li>
    </ul>
  </section>

  <RelatedCalculators current="debt-to-income" />
</PageLayout>

<script>
  const dtiDebtIds = ['housing-payment', 'student-payment', 'auto-payment', 'card-payment', 'other-payment'];
  const dtiInputIds = ['gross-income', ...dtiDebtIds];
  const dtiForm = document.querySelector<HTMLElement>('#dti-form');
  const dtiResult = document.querySelector<HTMLElement>('#dti-result');
  const dtiMoney = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
  const dtiPrefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function getDtiInput(id: string) {
    return document.querySelector<HTMLInputElement>(`#${id}`);
  }

  function clearDtiError(input: HTMLInputElement) {
    input.removeAttribute('aria-invalid');
    const error = document.querySelector<HTMLElement>(`#${input.id}-error`);
    if (error) {
      error.textContent = '';
      error.hidden = true;
    }
  }

  function readDtiAmount(input: HTMLInputElement, mustBePositive = false) {
    clearDtiError(input);
    const raw = input.value.trim();
    const value = raw === '' && !mustBePositive ? 0 : Number(raw);
    const invalid = !Number.isFinite(value) || (mustBePositive ? value <= 0 : value < 0);

    if (invalid) {
      input.setAttribute('aria-invalid', 'true');
      const error = document.querySelector<HTMLElement>(`#${input.id}-error`);
      if (error) {
        error.textContent = mustBePositive
          ? 'Enter gross monthly income greater than zero.'
          : 'Enter zero or a positive monthly payment.';
        error.hidden = false;
      }
      return null;
    }
    return value;
  }

  function describeDti(dti: number) {
    if (dti < 20) return { band: 'Lower', text: 'Your required debt payments represent a lower share of gross monthly income in this illustrative scale.' };
    if (dti < 35) return { band: 'Moderate', text: 'Your required debt payments represent a moderate share of gross monthly income in this illustrative scale.' };
    if (dti < 43) return { band: 'Elevated', text: 'Your required debt payments represent an elevated share of gross monthly income in this illustrative scale.' };
    return { band: 'High', text: 'Your required debt payments represent a high share of gross monthly income in this illustrative scale.' };
  }

  function calculateDti() {
    if (!dtiResult) return;

    const values = new Map<string, number>();
    let firstInvalid: HTMLInputElement | null = null;
    for (const id of dtiInputIds) {
      const input = getDtiInput(id);
      if (!input) continue;
      const value = readDtiAmount(input, id === 'gross-income');
      if (value === null) firstInvalid ??= input;
      else values.set(id, value);
    }

    if (firstInvalid) {
      dtiResult.hidden = true;
      firstInvalid.focus();
      return;
    }

    const income = values.get('gross-income') ?? 0;
    const monthlyDebt = dtiDebtIds.reduce((sum, id) => sum + (values.get(id) ?? 0), 0);
    const dti = (monthlyDebt / income) * 100;
    const description = describeDti(dti);

    const output = document.querySelector<HTMLOutputElement>('#dti-output');
    const debtOutput = document.querySelector<HTMLElement>('#monthly-debt-output');
    const incomeOutput = document.querySelector<HTMLElement>('#monthly-income-output');
    const bandOutput = document.querySelector<HTMLElement>('#dti-band-output');
    const interpretation = document.querySelector<HTMLElement>('#dti-interpretation');
    const worked = document.querySelector<HTMLElement>('#dti-worked');
    const marker = document.querySelector<HTMLElement>('#dti-marker');

    if (output) output.value = `${dti.toFixed(1)}%`;
    if (debtOutput) debtOutput.textContent = dtiMoney.format(monthlyDebt);
    if (incomeOutput) incomeOutput.textContent = dtiMoney.format(income);
    if (bandOutput) bandOutput.textContent = description.band;
    if (interpretation) interpretation.textContent = description.text;
    if (worked) worked.textContent = `${dtiMoney.format(monthlyDebt)} ÷ ${dtiMoney.format(income)} × 100 = ${dti.toFixed(1)}%.`;
    if (marker) marker.style.left = `${Math.min(Math.max(dti, 0), 60) / 60 * 100}%`;

    dtiResult.hidden = false;
    dtiResult.focus({ preventScroll: true });
    dtiResult.scrollIntoView({ behavior: dtiPrefersReducedMotion ? 'auto' : 'smooth', block: 'nearest' });
  }

  document.querySelector('[data-calculate-dti]')?.addEventListener('click', calculateDti);

  dtiForm?.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' || event.target instanceof HTMLButtonElement) return;
    event.preventDefault();
    calculateDti();
  });

  dtiForm?.addEventListener('input', (event) => {
    const input = event.target;
    if (input instanceof HTMLInputElement) clearDtiError(input);
  });

  document.querySelector('[data-clear-dti]')?.addEventListener('click', () => {
    const hasValues = dtiInputIds.some((id) => Boolean(getDtiInput(id)?.value));
    if (hasValues && !window.confirm('Clear all values from this debt-to-income calculation?')) return;
    dtiInputIds.forEach((id) => {
      const input = getDtiInput(id);
      if (input) {
        input.value = '';
        clearDtiError(input);
      }
    });
    if (dtiResult) dtiResult.hidden = true;
    getDtiInput('gross-income')?.focus();
  });
</script>

<style>
  .formula-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(0.4rem, 1.5vw, 0.8rem);
    margin-bottom: 1rem;
    padding: 0.9rem 1rem;
    overflow-x: visible;
    white-space: normal;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    color: var(--color-body);
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 2vw, 0.82rem);
    line-height: 1.45;
    text-align: center;
  }

  .formula-strip strong { color: var(--color-ink); }
  .calculator { padding: clamp(1rem, 3vw, 1.75rem); }
  .calculator__privacy { margin: 0 0 1.75rem; padding-bottom: 1rem; border-bottom: 1px solid var(--color-hairline); font-size: 0.8125rem; color: var(--color-body); }
  .calculator__privacy span { color: var(--color-status-cooking); }

  .primary-field {
    max-width: 460px;
    margin-bottom: 2rem;
    padding: 1.25rem;
    border: 1px solid var(--color-hairline-strong);
    border-radius: var(--radius-lg);
    background: var(--color-canvas-soft);
  }

  label { display: block; margin-bottom: 0.45rem; font-weight: 600; font-size: 0.9rem; color: var(--color-ink); }
  .primary-field > small, .money-field > small { display: block; margin-top: 0.4rem; color: var(--color-body); font-size: 0.75rem; line-height: 1.4; }

  fieldset { min-width: 0; margin: 0; padding: 2rem 0 0; border: 0; border-top: 1px solid var(--color-hairline); }
  legend { display: grid; gap: 0.2rem; width: 100%; padding: 0 0 1.25rem; font-size: 1.125rem; font-weight: 600; }
  legend small { color: var(--color-body); font-size: 0.8125rem; font-weight: 400; }

  .field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem 1rem; }
  .money-field { min-width: 0; }
  .money-input { position: relative; }
  .money-input > span { position: absolute; top: 50%; left: 0.9rem; transform: translateY(-50%); color: var(--color-body); pointer-events: none; }
  .money-input input { width: 100%; height: 50px; padding: 0 0.9rem 0 2rem; background: var(--color-canvas-soft); border: 1px solid var(--color-body); border-radius: var(--radius-md); color: var(--color-ink); font: inherit; }
  .money-input input::placeholder { color: var(--color-body); opacity: 1; }
  .money-input input:focus-visible { border-color: var(--color-link); outline: 2px solid color-mix(in srgb, var(--color-link) 30%, transparent); outline-offset: 1px; }
  .money-input input[aria-invalid='true'] { border-color: var(--color-status-apocalypse); }

  .field-error { display: block; margin-top: 0.35rem; color: var(--color-status-apocalypse); font-size: 0.8125rem; line-height: 1.4; }
  .field-error[hidden] { display: none; }
  .calculator__actions { display: flex; gap: 0.75rem; margin-top: 1.5rem; }

  .result { margin-top: 1rem; overflow: hidden; border: 1px solid color-mix(in srgb, var(--color-grad-amber) 44%, var(--color-hairline)); border-radius: var(--radius-xl); background: color-mix(in srgb, var(--color-grad-amber) 5%, var(--color-surface)); }
  .result[hidden] { display: none; }
  .result__head { padding: clamp(1.25rem, 4vw, 2rem); }
  .result__head h2 { margin: 0.35rem 0 0; font-family: var(--font-mono); font-size: clamp(2.5rem, 9vw, 4.5rem); line-height: 1; color: var(--color-grad-amber); }
  .result__head p { max-width: 620px; margin-bottom: 0; }

  .meter { padding: 0 2rem 1.5rem; }
  .meter__labels { display: flex; justify-content: space-between; color: var(--color-body); font-family: var(--font-mono); font-size: 0.65rem; }
  .meter__track { position: relative; display: grid; grid-template-columns: 20fr 15fr 8fr 17fr; height: 8px; margin-top: 0.5rem; overflow: visible; border-radius: var(--radius-pill); }
  .meter__segment--lower { background: var(--color-status-cooking); border-radius: var(--radius-pill) 0 0 var(--radius-pill); }
  .meter__segment--moderate { background: var(--color-status-stable); }
  .meter__segment--elevated { background: var(--color-grad-amber); }
  .meter__segment--high { background: var(--color-status-apocalypse); border-radius: 0 var(--radius-pill) var(--radius-pill) 0; }
  .meter__marker { position: absolute; top: 50%; width: 16px; height: 16px; border: 3px solid var(--color-canvas); border-radius: 50%; transform: translate(-50%, -50%); background: var(--color-ink); box-shadow: 0 0 0 1px var(--color-ink); }

  .result__stats { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--color-hairline); border-bottom: 1px solid var(--color-hairline); }
  .result__stats > div { display: grid; gap: 0.3rem; padding: 1rem 1.25rem; }
  .result__stats > div + div { border-left: 1px solid var(--color-hairline); }
  .result__stats span { color: var(--color-body); font-size: 0.72rem; }
  .result__stats strong { font-family: var(--font-mono); font-size: 0.95rem; }
  .result__worked { margin: 0; padding: 1rem 1.25rem 0; font-family: var(--font-mono); font-size: 0.8125rem; }
  .result__caveat { margin: 0; padding: 0.75rem 1.25rem 1.25rem; font-size: 0.78rem; }

  .method { margin-top: 3rem; }
  .band-table { width: 100%; margin: 1rem 0; overflow: hidden; border: 1px solid var(--color-hairline-strong); border-collapse: separate; border-spacing: 0; border-radius: var(--radius-lg); background: var(--color-paper); }
  .band-table caption { padding: 0.8rem 1rem; color: var(--color-ink); font-weight: 650; text-align: left; background: var(--color-canvas-soft-2); }
  .band-table th, .band-table td { padding: 0.8rem 1rem; border: 0; border-top: 1px solid var(--color-hairline); text-align: left; vertical-align: top; }
  .band-table thead th { color: var(--color-ink); font-size: 0.8rem; background: var(--color-canvas-soft); }
  .band-table tbody th { width: 150px; color: var(--color-ink); white-space: nowrap; }
  .band-table td { color: var(--color-body); }

  @media (max-width: 600px) {
    .field-grid { grid-template-columns: 1fr; }
    .calculator__actions { flex-direction: column; }
    .calculator__actions button { width: 100%; }
    .result__stats { grid-template-columns: 1fr; }
    .result__stats > div + div { border-left: 0; border-top: 1px solid var(--color-hairline); }
    .meter { padding-inline: 1.25rem; }
    .band-table tbody th { width: 40%; white-space: normal; }
  }
</style>
