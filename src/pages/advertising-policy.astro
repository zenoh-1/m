import PageLayout from '../layouts/PageLayout.astro';
import ContentNote from '../components/content/ContentNote.astro';
---

<PageLayout
  title="Advertising Policy | Cooked Finance"
  description="Cooked Finance is currently ad-free. These rules govern any future advertising placement, privacy, labeling, and editorial independence."
  path="/advertising-policy/"
  eyebrow="Commercial transparency"
  heading="No ads today. Clear boundaries before any arrive."
  lead="The site currently carries no paid advertising, affiliate placement, sponsored ranking, or AdSense code."
  updated="August 31, 2026"
>
  <ContentNote title="Advertising is a later-stage decision"><p>There is no public minimum-traffic number that guarantees AdSense approval. Cooked Finance will consider advertising only after the home-cost library is substantial, useful, stable, and receiving consistent non-branded traffic.</p></ContentNote>
  <h2>Future placement rules</h2><ul><li>Ads must be visibly distinguishable from navigation, controls, sources, results, safety notices, and editorial links.</li><li>Ads must never appear to be the next required step or a personalized recommendation.</li><li>Payment cannot change formulas, assumptions, rankings, safety conclusions, or source selection.</li><li>Advertising cannot buy hidden links, favorable coverage, or removal of accurate criticism.</li></ul>
  <h2>Places display ads should not appear</h2><ul><li>Inside calculator forms or personalized result blocks</li><li>Inside My Home or near add, delete, clear, and export controls</li><li>Inside safety warnings, recall checks, evidence panels, or methodology</li><li>On privacy, legal, corrections, contact, and advertising-policy pages</li><li>On thin or unfinished pages</li></ul>
  <h2>Privacy boundary</h2><p>Home-plan records, model numbers, notes, service dates, calculator values, quotes, financial inputs, and result bands must not be sent as advertising parameters or used to construct advertising audiences.</p>
  <h2>Consent and policy compliance</h2><p>Before advertising technology is activated, privacy disclosures and legally required consent controls will be updated. Advertising will remain subordinate to publisher content and will follow the applicable platform and publisher policies.</p>
  <h2>Sponsored and affiliate content</h2><p>If either is introduced, it will be labeled at the point of use. A commercial link will not be described as an official, safest, or best option without independent evidence that supports that claim.</p>
</PageLayout>
