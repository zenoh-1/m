---
/**
 * ShareCard — Visually strong social share card.
 *
 * Shows Cooked Score, Percentile, Financial Age, and the Roast. The
 * "Download Image" button paints the card to a canvas (1200×630, the
 * standard OG / X / LinkedIn ratio) and downloads a PNG — no external libs.
 * Native share is used on supporting devices; copy-link is the fallback.
 */
---

<div class="sharewrap">
  <div class="eyebrow sharewrap__eyebrow">Your share card</div>

  <!-- Visible card (also the visual reference for the canvas export) -->
  <div class="sharecard" data-share-card>
    <div class="sharecard__top">
      <span class="sharecard__brand">cookedfinance.com</span>
      <span class="sharecard__badge" data-share-badge>🥩 Medium Rare</span>
    </div>

    <div class="sharecard__score">
      <span class="sharecard__score-num" data-share-score>0</span>
      <span class="sharecard__score-den">/100</span>
      <span class="sharecard__score-label">Cooked Score</span>
    </div>

    <p class="sharecard__roast" data-share-roast>&nbsp;</p>

    <div class="sharecard__stats">
      <div class="sharecard__stat">
        <span class="sharecard__stat-value" data-share-percentile>—</span>
        <span class="sharecard__stat-label">Ahead of Americans</span>
      </div>
      <div class="sharecard__stat">
        <span class="sharecard__stat-value" data-share-finage>—</span>
        <span class="sharecard__stat-label">Financial Age</span>
      </div>
    </div>

    <p class="sharecard__cta">Are you financially cooked? Find out →</p>
  </div>

  <!-- Hidden canvas used for PNG export -->
  <canvas data-share-canvas width="1200" height="630" hidden></canvas>

  <div class="sharewrap__actions">
    <button type="button" class="btn-primary" data-download-share>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M8 2v8m0 0L5 7m3 3 3-3M3 13h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Download Image
    </button>
    <button type="button" class="btn-secondary" data-share-native>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M11 5a2 2 0 1 0-1.9-1.4L6.1 5.3a2 2 0 1 0 0 5.4l3 1.7a2 2 0 1 0 .6-1L6.8 9.7a2 2 0 0 0 0-3.4l2.9-1.7c.36.25.8.4 1.3.4Z" fill="currentColor"/>
      </svg>
      Share
    </button>
  </div>

  <div class="sharewrap__socials" aria-label="Share to social platforms">
    <a class="social" data-share-x target="_blank" rel="noopener" aria-label="Share on X">X</a>
    <a class="social" data-share-reddit target="_blank" rel="noopener" aria-label="Share on Reddit">Reddit</a>
    <a class="social" data-share-linkedin target="_blank" rel="noopener" aria-label="Share on LinkedIn">LinkedIn</a>
    <button class="social" type="button" data-copy-link aria-label="Copy link for Discord & more">Copy link</button>
  </div>
  <p class="sharewrap__toast" data-share-toast role="status" aria-live="polite" hidden></p>
</div>

<style>
  .sharewrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .sharewrap__eyebrow { align-self: flex-start; }

  /* The visible share card — gradient-forward, premium.
     Uses a min aspect ratio rather than a fixed one so the content (esp. the
     roast) never clips on narrow phones. The PNG export is always 1200×630. */
  .sharecard {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 1200 / 630;
    min-height: 280px;
    padding: clamp(1.25rem, 4vw, 2rem);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-hairline);
    background:
      radial-gradient(130% 120% at 100% 0%, rgba(121, 40, 202, 0.35), transparent 55%),
      radial-gradient(120% 120% at 0% 100%, rgba(0, 124, 240, 0.28), transparent 55%),
      var(--color-canvas-soft);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 40px -12px rgba(0, 0, 0, 0.6);
  }

  .sharecard__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .sharecard__brand {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-body);
    letter-spacing: 0.02em;
  }
  .sharecard__badge {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--color-hairline-strong);
    white-space: nowrap;
  }

  .sharecard__score {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    margin-top: auto;
    flex-wrap: wrap;
  }
  .sharecard__score-num {
    font-size: clamp(3rem, 12vw, 4.5rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .sharecard__score-den {
    font-size: 1.25rem;
    color: var(--color-mute);
    font-weight: 500;
  }
  .sharecard__score-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-body);
    width: 100%;
  }

  .sharecard__roast {
    margin: 0.875rem 0;
    font-size: clamp(0.9375rem, 2.4vw, 1.125rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .sharecard__stats {
    display: flex;
    gap: 1.5rem;
  }
  .sharecard__stat { display: flex; flex-direction: column; gap: 0.125rem; }
  .sharecard__stat-value {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .sharecard__stat-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-mute);
  }

  .sharecard__cta {
    margin: 0.875rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-body);
  }

  .sharewrap__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    width: 100%;
  }
  .sharewrap__actions :global(.btn-primary),
  .sharewrap__actions :global(.btn-secondary) {
    flex: 1 1 auto;
  }
  @media (min-width: 480px) {
    .sharewrap__actions :global(.btn-primary),
    .sharewrap__actions :global(.btn-secondary) {
      flex: 0 1 auto;
    }
  }

  .sharewrap__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .social {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-body);
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    background: transparent;
    cursor: pointer;
    transition: border-color 0.18s var(--ease-out-expo), color 0.18s var(--ease-out-expo);
    text-decoration: none;
  }
  .social:hover { border-color: var(--color-hairline-strong); color: var(--color-ink); }

  .sharewrap__toast {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-status-cooking);
  }

  /* On narrow phones, let the card grow to fit content instead of clipping. */
  @media (max-width: 460px) {
    .sharecard {
      aspect-ratio: auto;
      min-height: 0;
    }
    .sharecard__score { margin-top: 1rem; }
    .sharecard__stats { gap: 1.25rem; }
  }
</style>
