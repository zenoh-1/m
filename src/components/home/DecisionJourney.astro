<script>
  document.querySelectorAll<HTMLElement>('[data-decision-journey]').forEach((section) => {
    const backdrop = section.querySelector<HTMLElement>('[data-decision-backdrop]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const compactViewport = window.matchMedia('(max-width: 700px)');

    if (!backdrop || reducedMotion.matches || compactViewport.matches) return;

    const keyframes = [
      { x: 48, y: 18, scale: 1.04 },
      { x: 32, y: -34, scale: 1.11 },
      { x: -46, y: -30, scale: 1.12 },
    ];

    let visible = false;
    let targetProgress = 0;
    let renderedProgress = 0;
    let frame = 0;

    const clamp = (value: number) => Math.min(Math.max(value, 0), 1);
    const smoothstep = (value: number) => value * value * (3 - 2 * value);

    const interpolate = (progress: number) => {
      const segmentCount = keyframes.length - 1;
      const scaled = progress * segmentCount;
      const index = Math.min(Math.floor(scaled), segmentCount - 1);
      const local = smoothstep(scaled - index);
      const from = keyframes[index];
      const to = keyframes[index + 1];
      return {
        x: from.x + (to.x - from.x) * local,
        y: from.y + (to.y - from.y) * local,
        scale: from.scale + (to.scale - from.scale) * local,
      };
    };

    const readProgress = () => {
      const rect = section.getBoundingClientRect();
      return clamp((window.innerHeight - rect.top) / (window.innerHeight + rect.height));
    };

    const render = () => {
      frame = 0;
      renderedProgress += (targetProgress - renderedProgress) * 0.06;
      const point = interpolate(renderedProgress);
      backdrop.style.setProperty('--journey-x', `${point.x.toFixed(2)}px`);
      backdrop.style.setProperty('--journey-y', `${point.y.toFixed(2)}px`);
      backdrop.style.setProperty('--journey-scale', point.scale.toFixed(4));

      if (visible && Math.abs(targetProgress - renderedProgress) > 0.0005) {
        frame = window.requestAnimationFrame(render);
      }
    };

    const requestUpdate = () => {
      if (!visible) return;
      targetProgress = readProgress();
      if (!frame) frame = window.requestAnimationFrame(render);
    };

    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      backdrop.classList.toggle('is-moving', visible);

      if (visible) {
        targetProgress = readProgress();
        if (renderedProgress === 0) renderedProgress = targetProgress;
        if (!frame) frame = window.requestAnimationFrame(render);
      } else if (frame) {
        window.cancelAnimationFrame(frame);
        frame = 0;
      }
    }, { rootMargin: '16% 0px' });

    observer.observe(section);
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
  });
</script>

