<section id="check" class="assess card" aria-labelledby="assessment-title">
  <div class="assess__topline">
    <div>
      <span class="assess__step">Your Private Check</span>
      <h2 id="assessment-title">Take Your Financial Temperature</h2>
    </div>
    <span class="assess__time">≈ 90 sec</span>
  </div>

  <p class="assess__intro">Round numbers are fine. Use your own figures throughout; run a separate check for a partner.</p>

  <div class="assess__saved" data-saved-prompt hidden>
    <div>
      <strong>A previous check is saved on this device.</strong>
      <span>Load its inputs when you are ready—nothing is restored automatically.</span>
    </div>
    <div class="assess__saved-actions">
      <button type="button" class="btn-quiet" data-load-saved>Load Saved Inputs</button>
      <button type="button" class="btn-quiet" data-clear-saved-prompt>Delete</button>
    </div>
    <p data-saved-prompt-status role="status" aria-live="polite"></p>
  </div>
  <p class="sr-only" data-storage-announcement role="status" aria-live="polite" aria-atomic="true"></p>

  <div id="assessment-form" role="form" aria-labelledby="assessment-title">
    <div class="assess__grid">
      <div class="field">
        <label class="field__label" for="age">Age <span class="field__hint">18–80</span></label>
        <input class="field-input" id="age" type="number" inputmode="numeric" min="18" max="80" step="1" placeholder="32…" required autocomplete="off" aria-describedby="age-help age-error" />
        <p id="age-help" class="field__hint-line">Used only for your personal long-term savings guidepost.</p>
        <p id="age-error" class="field__error" data-error-for="age" aria-live="polite"></p>
      </div>

      <div class="field">
        <label class="field__label" for="annual-income">Gross annual income <span class="sr-only">in U.S. dollars</span></label>
        <div class="field__money">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="field-input field-input--money" id="annual-income" type="text" inputmode="numeric" placeholder="75,000…" required autocomplete="off" spellcheck="false" aria-describedby="annual-income-help annual-income-error" />
        </div>
        <p id="annual-income-help" class="field__hint-line">Before taxes and deductions. Must be greater than $0.</p>
        <p id="annual-income-error" class="field__error" data-error-for="annual-income" aria-live="polite"></p>
      </div>

      <div class="field">
        <label class="field__label" for="monthly-expenses">Essential monthly spending <span class="sr-only">in U.S. dollars</span></label>
        <div class="field__money">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="field-input field-input--money" id="monthly-expenses" type="text" inputmode="numeric" placeholder="3,200…" required autocomplete="off" spellcheck="false" aria-describedby="monthly-expenses-help monthly-expenses-error" />
        </div>
        <p id="monthly-expenses-help" class="field__hint-line">Housing, food, utilities, transport, insurance, and required debt minimums. Must be greater than $0; repeat debt minimums below for payment burden.</p>
        <p id="monthly-expenses-error" class="field__error" data-error-for="monthly-expenses" aria-live="polite"></p>
      </div>

      <div class="field">
        <label class="field__label" for="liquid-savings">Liquid savings <span class="sr-only">in U.S. dollars</span></label>
        <div class="field__money">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="field-input field-input--money" id="liquid-savings" type="text" inputmode="numeric" placeholder="12,000…" required autocomplete="off" spellcheck="false" aria-describedby="liquid-savings-help liquid-savings-error" />
        </div>
        <p id="liquid-savings-help" class="field__hint-line">Cash you could reach for an emergency.</p>
        <p id="liquid-savings-error" class="field__error" data-error-for="liquid-savings" aria-live="polite"></p>
      </div>

      <div class="field">
        <label class="field__label" for="monthly-debt">Monthly debt payments <span class="sr-only">in U.S. dollars</span></label>
        <div class="field__money">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="field-input field-input--money" id="monthly-debt" type="text" inputmode="numeric" placeholder="1,100…" required autocomplete="off" spellcheck="false" aria-describedby="monthly-debt-help monthly-debt-error" />
        </div>
        <p id="monthly-debt-help" class="field__hint-line">Required mortgage and loan/card payments—not balances.</p>
        <p id="monthly-debt-error" class="field__error" data-error-for="monthly-debt" aria-live="polite"></p>
      </div>

      <div class="field">
        <label class="field__label" for="retirement-investments">Retirement &amp; investments <span class="sr-only">in U.S. dollars</span></label>
        <div class="field__money">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="field-input field-input--money" id="retirement-investments" type="text" inputmode="numeric" placeholder="45,000…" required autocomplete="off" spellcheck="false" aria-describedby="retirement-investments-help retirement-investments-error" />
        </div>
        <p id="retirement-investments-help" class="field__hint-line">401(k), IRA, brokerage, and a vested pension account or cash-balance value. Exclude projected monthly pension income.</p>
        <p id="retirement-investments-error" class="field__error" data-error-for="retirement-investments" aria-live="polite"></p>
      </div>

      <div class="field field--wide">
        <label class="field__label" for="monthly-savings">Amount saved or invested each month <span class="sr-only">in U.S. dollars</span></label>
        <div class="field__money">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="field-input field-input--money" id="monthly-savings" type="text" inputmode="numeric" placeholder="800…" required autocomplete="off" spellcheck="false" enterkeyhint="go" aria-describedby="monthly-savings-help monthly-savings-error" />
        </div>
        <p id="monthly-savings-help" class="field__hint-line">Include automatic retirement contributions you want counted.</p>
        <p id="monthly-savings-error" class="field__error" data-error-for="monthly-savings" aria-live="polite"></p>
      </div>
    </div>

    <button type="button" class="btn-primary assess__submit" data-run-assessment>
      Reveal My Heat Check
      <svg width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
        <path d="M3 8.5h11M10 4.5l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <p class="assess__privacy"><span aria-hidden="true">◆</span> Calculated in this browser. Nothing is saved unless you choose to save your result afterward.</p>
  </div>
</section>

<style>
  .assess { align-self: start; padding: clamp(1.2rem, 3vw, 1.7rem); border-top: 4px solid var(--color-ink); scroll-margin-top: 6.5rem; }
  .assess__topline { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--color-hairline); }
  .assess__step { color: var(--color-ember-deep); font-family: var(--font-mono); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  h2 { margin: 0.35rem 0 0; font-family: var(--font-serif); font-size: clamp(1.65rem, 4vw, 2.25rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1.05; }
  .assess__time { flex: 0 0 auto; padding: 0.35rem 0.6rem; border: 1px solid var(--color-hairline); border-radius: var(--radius-pill); color: var(--color-body); font-family: var(--font-mono); font-size: 0.66rem; }
  .assess__intro { margin: 0.85rem 0 1rem; color: var(--color-body); font-size: 0.82rem; line-height: 1.5; }
  .assess__saved { margin: 0 0 1rem; padding: 0.8rem; border: 1px solid color-mix(in srgb, var(--color-sage) 34%, transparent); border-radius: var(--radius-sm); background: var(--color-sage-soft); }
  .assess__saved > div:first-child { display: grid; gap: 0.15rem; }
  .assess__saved strong { font-size: 0.78rem; }
  .assess__saved span { color: var(--color-body); font-size: 0.7rem; line-height: 1.4; }
  .assess__saved-actions { margin-top: 0.55rem; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .assess__saved-actions button { min-height: 36px; padding: 0.35rem 0.65rem; font-size: 0.68rem; }
  .assess__saved > p { min-height: 0; margin: 0.45rem 0 0; color: var(--color-sage); font-size: 0.68rem; }
  .assess__saved > p:empty { display: none; }
  .assess__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem 0.9rem; }
  .field--wide { grid-column: 1 / -1; }
  .field__error:empty { display: none; }
  .assess__submit { width: 100%; margin-top: 1.1rem; }
  .assess__privacy { margin: 0.8rem 0 0; color: var(--color-mute); font-size: 0.7rem; line-height: 1.45; text-align: center; }
  .assess__privacy span { color: var(--color-sage); }
  @media (max-width: 560px) {
    .assess__grid { grid-template-columns: 1fr; }
    .field--wide { grid-column: auto; }
  }
</style>
