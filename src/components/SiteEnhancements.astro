<div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

<button class="back-to-top" type="button" data-back-to-top hidden aria-label="Back to top">
  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
    <path d="m4.5 10.5 4.5-4.5 4.5 4.5M9 6v7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span>Top</span>
</button>

<script>
  document.documentElement.classList.add('has-js');

  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
  const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  const siteHeader = document.querySelector<HTMLElement>('[data-site-header]');
  let frameRequested = false;

  const updatePageChrome = () => {
    frameRequested = false;
    const scrollable = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
    const ratio = Math.min(Math.max(window.scrollY / scrollable, 0), 1);
    progress?.style.setProperty('--reading-progress', String(ratio));
    siteHeader?.toggleAttribute('data-scrolled', window.scrollY > 18);
    if (backToTop) backToTop.hidden = window.scrollY < 720;
  };

  const requestPageChromeUpdate = () => {
    if (frameRequested) return;
    frameRequested = true;
    window.requestAnimationFrame(updatePageChrome);
  };

  window.addEventListener('scroll', requestPageChromeUpdate, { passive: true });
  window.addEventListener('resize', requestPageChromeUpdate, { passive: true });
  updatePageChrome();

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  backToTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' }));

  const revealItems = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
  if (!reduceMotion && 'IntersectionObserver' in window) {
    revealItems.forEach((item) => item.setAttribute('data-reveal-ready', ''));
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        (entry.target as HTMLElement).setAttribute('data-revealed', '');
        observer.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    revealItems.forEach((item) => revealObserver.observe(item));
  }
</script>

<style>
  .reading-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 110;
    height: 3px;
    overflow: hidden;
    pointer-events: none;
  }

  .reading-progress span {
    width: 100%;
    height: 100%;
    display: block;
    transform: scaleX(var(--reading-progress, 0));
    transform-origin: left center;
    background: linear-gradient(90deg, var(--color-ember), var(--color-amber), var(--color-sage));
  }

  .back-to-top {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 65;
    min-width: 52px;
    min-height: 52px;
    display: grid;
    place-items: center;
    gap: 0.08rem;
    padding: 0.45rem;
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-sm);
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: 3px 3px 0 var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 720;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: transform 180ms var(--ease-out-expo), box-shadow 180ms ease;
  }

  .back-to-top:hover { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 var(--color-ink); }
  .back-to-top:active { transform: translate(1px, 1px); box-shadow: 2px 2px 0 var(--color-ink); }

  :global([data-reveal-ready]) {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 440ms ease, transform 440ms var(--ease-out-expo);
  }

  :global([data-reveal-ready][data-revealed]) { opacity: 1; transform: translateY(0); }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress span, .back-to-top, :global([data-reveal-ready]) { transition: none; }
  }
</style>
