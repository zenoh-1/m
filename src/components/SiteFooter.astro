---
import BrandMark from './BrandMark.astro';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container-page">
    <div class="footer__top">
      <div class="footer__brand-block">
        <a href="/" class="footer__brand" aria-label="Cooked Finance home">
          <BrandMark size={40} />
          <span translate="no">Cooked Finance</span>
        </a>
        <p class="footer__statement">Run it. Care for it. Decide with the math.</p>
        <p>Home running costs, maintenance planning, and repair decisions with transparent math.</p>
        <span class="footer__status">Independent · Educational · Currently ad-free</span>
      </div>

      <nav class="footer__nav" aria-label="Footer navigation">
        <div>
          <h2>Use</h2>
          <a href="/systems/">System Guides</a>
          <a href="/tools/energy-cost/">Energy Cost Calculator</a>
          <a href="/tools/repair-or-replace/">Repair or Replace</a>
          <a href="/my-home/">My Home</a>
        </div>
        <div>
          <h2>Company</h2>
          <a href="/about/">About</a>
          <a href="/methodology/">Methodology</a>
          <a href="/contact/">Contact</a>
          <a href="/calculators/">Money Tools</a>
        </div>
        <div>
          <h2>Trust</h2>
          <a href="/editorial-policy/">Editorial Policy</a>
          <a href="/source-policy/">Source Policy</a>
          <a href="/corrections-policy/">Corrections</a>
          <a href="/advertising-policy/">Advertising Policy</a>
          <a href="/privacy/">Privacy</a>
        </div>
      </nav>
    </div>

    <div class="footer__bottom">
      <p>© {year} Cooked Finance. Educational estimates, not professional advice.</p>
      <div>
        <a href="/terms/">Terms</a>
        <a href="/contact/">Contact</a>
        <button type="button" data-open-privacy>Privacy Choices</button>
      </div>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll('[data-open-privacy]').forEach((button) => {
    button.addEventListener('click', () => document.dispatchEvent(new Event('cooked:privacy-choices')));
  });
</script>

<style>
  .footer { position: relative; padding: clamp(3.5rem, 8vw, 6.5rem) 0 max(2rem, env(safe-area-inset-bottom)); border-top: 1px solid var(--color-ink); background: #e5dac9; }
  .footer::before { content: ''; position: absolute; inset: 0 0 auto; height: 7px; background: linear-gradient(90deg, var(--color-ember) 0 34%, var(--color-amber) 34% 68%, var(--color-sage) 68%); }
  .footer__top { display: grid; grid-template-columns: minmax(15rem, 0.85fr) minmax(0, 1.4fr); gap: clamp(2.5rem, 8vw, 7rem); }
  .footer__brand { display: inline-flex; align-items: center; gap: 0.75rem; color: var(--color-ink); font-weight: 780; letter-spacing: -0.025em; text-decoration: none; }
  .footer__brand-block p { max-width: 31ch; margin: 1.1rem 0; color: var(--color-body); line-height: 1.6; }
  .footer__brand-block .footer__statement { max-width: 12ch; margin: 1.6rem 0 1rem; color: var(--color-ink); font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.04em; line-height: 0.98; }
  .footer__status { display: inline-flex; color: var(--color-sage); font-family: var(--font-mono); font-size: 0.68rem; font-weight: 650; letter-spacing: 0.04em; text-transform: uppercase; }
  .footer__nav { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .footer__nav > div { display: flex; flex-direction: column; }
  .footer__nav h2 { margin: 0 0 0.35rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--color-hairline-strong); color: var(--color-ink); font-family: var(--font-mono); font-size: 0.67rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .footer__nav a { width: fit-content; min-height: 44px; display: inline-flex; align-items: center; color: var(--color-body); font-size: 0.85rem; text-decoration: none; }
  .footer__nav a:hover { color: var(--color-ink); text-decoration: underline; text-underline-offset: 0.2em; }
  .footer__bottom { margin-top: clamp(2.5rem, 6vw, 5rem); padding-top: 1.2rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--color-hairline-strong); color: var(--color-mute); font-size: 0.75rem; }
  .footer__bottom p { margin: 0; }
  .footer__bottom div { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .footer__bottom a, .footer__bottom button { padding: 0; border: 0; background: none; color: var(--color-body); font: inherit; text-decoration: underline; text-underline-offset: 0.18em; }
  .footer__bottom a:hover, .footer__bottom button:hover { color: var(--color-ink); }
  @media (max-width: 800px) {
    .footer__top { grid-template-columns: 1fr; }
    .footer__bottom { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 520px) { .footer__nav { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 380px) { .footer__nav { grid-template-columns: 1fr; } }
</style>
