---
import BrandMark from './BrandMark.astro';
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<header class="site-header" data-site-header>
  <div class="container-page site-header__inner">
    <a href="/" class="brand" aria-label="Cooked Finance home">
      <BrandMark size={36} />
      <span class="brand__lockup">
        <span class="brand__text" translate="no">Cooked Finance</span>
        <span class="brand__descriptor">Home operating manual</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="/systems/" aria-current={currentPath.startsWith('/systems/') ? 'page' : undefined}>Systems</a>
      <a href="/tools/" aria-current={currentPath.startsWith('/tools/') ? 'page' : undefined}>Tools</a>
      <a href="/my-home/" aria-current={currentPath === '/my-home/' ? 'page' : undefined}>My Home <span class="nav-count" data-home-count hidden>0</span></a>
      <a href="/calculators/" aria-current={currentPath.startsWith('/calculators/') || currentPath.startsWith('/money-tools/') ? 'page' : undefined}>Money Tools</a>
      <a href="/about/" aria-current={currentPath === '/about/' ? 'page' : undefined}>About</a>
    </nav>

    <a href="/tools/energy-cost/" class="btn-primary btn-primary--small header-cta">Check a Running Cost</a>

    <details class="mobile-nav">
      <summary aria-label="Navigation menu">
        <span>Menu</span>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M3 5h12M3 9h12M3 13h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </summary>
      <nav aria-label="Mobile navigation">
        <a href="/tools/energy-cost/">Check a Running Cost</a>
        <a href="/systems/" aria-current={currentPath.startsWith('/systems/') ? 'page' : undefined}>Systems</a>
        <a href="/tools/" aria-current={currentPath.startsWith('/tools/') ? 'page' : undefined}>Tools</a>
        <a href="/my-home/" aria-current={currentPath === '/my-home/' ? 'page' : undefined}>My Home <span class="nav-count" data-home-count hidden>0</span></a>
        <a href="/calculators/" aria-current={currentPath.startsWith('/calculators/') || currentPath.startsWith('/money-tools/') ? 'page' : undefined}>Money Tools</a>
        <a href="/about/" aria-current={currentPath === '/about/' ? 'page' : undefined}>About</a>
      </nav>
    </details>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLDetailsElement>('details.mobile-nav').forEach((menu) => {
    const summary = menu.querySelector('summary');
    const close = (returnFocus = false) => {
      if (!menu.open) return;
      menu.open = false;
      if (returnFocus) summary?.focus();
    };
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => close()));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close(true);
    });
    document.addEventListener('pointerdown', (event) => {
      if (!menu.contains(event.target as Node)) close();
    });
  });

  try {
    const rawPlan = localStorage.getItem('cooked-finance-home-plan-v1');
    const parsedPlan = rawPlan ? JSON.parse(rawPlan) : null;
    const savedCount = Array.isArray(parsedPlan?.items) ? parsedPlan.items.length : 0;
    document.querySelectorAll<HTMLElement>('[data-home-count]').forEach((badge) => {
      badge.textContent = String(savedCount);
      badge.hidden = savedCount === 0;
      badge.setAttribute('aria-label', `${savedCount} saved ${savedCount === 1 ? 'item' : 'items'}`);
    });
  } catch {
    // A count is an enhancement; navigation remains fully usable without storage.
  }
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 70; border-bottom: 1px solid rgba(139, 124, 105, 0.72); background: rgba(243, 236, 223, 0.93); backdrop-filter: blur(18px); transition: box-shadow 180ms ease, background-color 180ms ease; }
  .site-header::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 5px; background: linear-gradient(var(--color-ember) 0 35%, var(--color-amber) 35% 67%, var(--color-sage) 67%); }
  .site-header[data-scrolled] { background: rgba(255, 253, 248, 0.96); box-shadow: 0 8px 25px rgba(25, 23, 18, 0.08); }
  .site-header__inner { min-height: 76px; display: flex; align-items: center; gap: 1.5rem; }
  .brand { min-width: max-content; display: inline-flex; align-items: center; gap: 0.72rem; color: var(--color-ink); font-weight: 760; letter-spacing: -0.025em; text-decoration: none; }
  .brand__text { font-size: 1.02rem; }
  .brand__lockup { display: grid; gap: 0.12rem; }
  .brand__descriptor { color: var(--color-mute); font-family: var(--font-mono); font-size: 0.54rem; font-weight: 650; letter-spacing: 0.08em; text-transform: uppercase; }
  .desktop-nav { margin-left: auto; display: flex; align-items: center; gap: 0.15rem; }
  .desktop-nav a { position: relative; min-height: 44px; display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.6rem 0.75rem; color: var(--color-body); font-size: 0.84rem; font-weight: 620; text-decoration: none; }
  .desktop-nav a::after { content: ''; position: absolute; inset: auto 0.7rem 0.35rem; height: 2px; transform: scaleX(0); transform-origin: left; background: var(--color-ember); transition: transform 180ms var(--ease-out-expo); }
  .desktop-nav a:hover { color: var(--color-ink); }
  .desktop-nav a:hover::after, .desktop-nav a[aria-current='page']::after { transform: scaleX(1); }
  .desktop-nav a[aria-current='page'] { color: var(--color-ink); }
  .nav-count { min-width: 1.25rem; min-height: 1.25rem; display: inline-grid; place-items: center; border-radius: 50%; background: var(--color-ember); color: #fff; font-family: var(--font-mono); font-size: 0.58rem; }
  .header-cta { flex: 0 0 auto; }
  .mobile-nav { display: none; margin-left: auto; position: relative; }
  .mobile-nav summary { min-width: 72px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.5rem 0.7rem; border: 1px solid var(--color-ink); border-radius: var(--radius-sm); background: var(--color-paper); color: var(--color-ink); font-size: 0.8rem; font-weight: 700; list-style: none; cursor: pointer; box-shadow: 2px 2px 0 var(--color-ink); }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav nav { position: absolute; right: 0; top: calc(100% + 0.65rem); width: min(18rem, calc(100vw - 2rem)); max-height: calc(100dvh - 6.5rem); display: grid; overflow-y: auto; overscroll-behavior: contain; padding: 0.55rem 0.55rem max(0.55rem, env(safe-area-inset-bottom)); border: 1px solid var(--color-ink); border-radius: var(--radius-sm); background: var(--color-paper); box-shadow: var(--shadow-raised); transform-origin: top right; animation: menu-in 180ms var(--ease-out-expo); }
  .mobile-nav nav a { min-height: 46px; display: flex; align-items: center; padding: 0.7rem 0.85rem; border-radius: var(--radius-sm); color: var(--color-body); font-size: 0.9rem; font-weight: 650; text-decoration: none; }
  .mobile-nav nav a:hover { color: var(--color-ink); background: var(--color-surface-2); }
  .mobile-nav nav a[aria-current='page'] { color: var(--color-ink); background: var(--color-canvas-soft); }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-6px) scale(0.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @media (max-width: 1120px) {
    .desktop-nav, .header-cta { display: none; }
    .mobile-nav { display: block; }
  }
  @media (max-width: 460px) {
    .brand__descriptor { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header, .desktop-nav a::after, .mobile-nav nav { transition: none; animation: none; }
  }
</style>
