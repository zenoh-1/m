---
import { FAQ_ITEMS } from '../lib/seo';
---

<section id="faq" class="section faq" aria-labelledby="faq-heading">
  <div class="container-page faq__grid">
    <div class="faq__intro">
      <span class="eyebrow">Good Questions</span>
      <h2 id="faq-heading">Before You Hand Over Seven Numbers</h2>
      <p>Short answers about privacy, accuracy, and what this tool is actually designed to do.</p>
      <a href="/contact/">Still wondering about something? Contact us →</a>
    </div>

    <div class="faq__items">
      {FAQ_ITEMS.map((item, index) => (
        <details open={index === 0}>
          <summary>
            <span>{item.q}</span>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M4 7l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid { display: grid; grid-template-columns: minmax(16rem, 0.75fr) minmax(0, 1.25fr); gap: clamp(2.5rem, 9vw, 8rem); align-items: start; }
  .faq__intro { position: sticky; top: 7rem; }
  .faq__intro h2 { max-width: 10ch; margin: 0.75rem 0 0; font-family: var(--font-serif); font-size: clamp(2.4rem, 5vw, 4rem); font-weight: 500; letter-spacing: -0.045em; line-height: 0.98; }
  .faq__intro p { max-width: 35ch; margin: 1rem 0; color: var(--color-body); line-height: 1.65; }
  .faq__intro a { color: var(--color-ember-deep); font-size: 0.85rem; font-weight: 680; text-underline-offset: 0.2em; }
  .faq__items { border-top: 1px solid var(--color-hairline-strong); }
  details { border-bottom: 1px solid var(--color-hairline); }
  summary { min-height: 68px; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 1rem; padding: 0.9rem 0; color: var(--color-ink); font-size: 0.98rem; font-weight: 680; list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  summary svg { transition: transform 180ms var(--ease-out-expo); }
  details[open] summary svg { transform: rotate(180deg); }
  details p { margin: -0.15rem 2.5rem 1.2rem 0; color: var(--color-body); font-size: 0.9rem; line-height: 1.65; }
  @media (max-width: 760px) {
    .faq__grid { grid-template-columns: 1fr; }
    .faq__intro { position: static; }
    .faq__intro h2 { max-width: 14ch; }
  }
</style>
