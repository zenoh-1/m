---
import Layout from './Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow?: string;
  heading: string;
  lead?: string;
  updated?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | string;
}

const { title, description, path, eyebrow, heading, lead, updated, noindex, type, jsonLd } = Astro.props;

const canonicalPath = path === '/' || path.endsWith('/') ? path : `${path}/`;
const canonicalURL = new URL(canonicalPath, SITE.url).href;
const breadcrumbPageName = title.split('|')[0].trim();

type Breadcrumb = {
  label: string;
  href?: string;
  current?: boolean;
  includeInSchema?: boolean;
};

const section = canonicalPath.startsWith('/guides/')
  ? { label: 'Guides', href: '/guides/' }
  : canonicalPath.startsWith('/calculators/')
    ? { label: 'Money Tools', href: '/calculators/' }
    : canonicalPath.startsWith('/money-tools/')
      ? { label: 'Money Tools', href: '/calculators/' }
    : canonicalPath.startsWith('/tools/')
      ? { label: 'Tools', href: '/tools/' }
    : canonicalPath.startsWith('/systems/')
      ? { label: 'Systems', href: '/systems/' }
    : canonicalPath.startsWith('/benchmarks/')
      // There is no benchmarks collection page yet, so this is a visible
      // hierarchy label rather than a link to a nonexistent URL.
      ? { label: 'Benchmarks', includeInSchema: false }
      : null;

const breadcrumbs: Breadcrumb[] = [{ label: 'Home', href: '/' }];
if (section && canonicalPath !== section.href) breadcrumbs.push(section);
breadcrumbs.push({ label: breadcrumbPageName, href: canonicalPath, current: true });

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs
    .filter((crumb) => crumb.includeInSchema !== false)
    .map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.label,
      item: new URL(crumb.href ?? canonicalPath, SITE.url).href,
    })),
};

const updatedISO = updated
  ? new Date(`${updated} 00:00:00 UTC`).toISOString().slice(0, 10)
  : null;
const isArticle = Boolean(
  updatedISO && (
    (canonicalPath.startsWith('/guides/') && canonicalPath !== '/guides/') ||
    canonicalPath.startsWith('/benchmarks/') ||
    ['/financial-health-score/', '/methodology/', '/score-ranges/'].includes(canonicalPath)
  ),
);
const resolvedType = type ?? (isArticle ? 'article' : 'website');

const articleJsonLd = isArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: heading,
      description,
      mainEntityOfPage: canonicalURL,
      dateModified: updatedISO,
      inLanguage: 'en-US',
      author: {
        '@type': 'Organization',
        name: SITE.name,
        url: `${SITE.url}/about/`,
      },
      publisher: {
        '@type': 'Organization',
        '@id': `${SITE.url}/#organization`,
        name: SITE.name,
        url: `${SITE.url}/`,
      },
    }
  : null;

function normalizeJsonLd(value: typeof jsonLd): Record<string, unknown>[] {
  if (!value) return [];
  if (Array.isArray(value)) return value;
  if (typeof value === 'string') {
    try {
      const parsed = JSON.parse(value);
      return Array.isArray(parsed) ? parsed : [parsed];
    } catch {
      return [];
    }
  }
  return [value];
}

const mergedJsonLd = [
  breadcrumbJsonLd,
  ...(articleJsonLd ? [articleJsonLd] : []),
  ...normalizeJsonLd(jsonLd),
];
const legacyFinancePath = canonicalPath.startsWith('/calculators/')
  || canonicalPath.startsWith('/money-tools/')
  || canonicalPath.startsWith('/guides/')
  || canonicalPath.startsWith('/benchmarks/')
  || ['/financial-health-score/', '/score-ranges/'].includes(canonicalPath);
const nextPrompt = legacyFinancePath
  ? { text: 'Want the original private financial snapshot?', href: '/money-tools/financial-health-check/', label: 'Run the Financial Health Check' }
  : { text: 'Ready to use the new home-cost toolkit?', href: '/systems/', label: 'Browse Home System Guides' };
---

<Layout title={title} description={description} path={path} noindex={noindex} type={resolvedType} jsonLd={mergedJsonLd}>
  <SiteHeader />

  <main id="main-content" class="page">
    <div class="container-page">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        {breadcrumbs.map((crumb, index) => (
          <>
            {index > 0 && <span aria-hidden="true">/</span>}
            {crumb.current || !crumb.href
              ? <span aria-current={crumb.current ? 'page' : undefined}>{crumb.label}</span>
              : <a href={crumb.href}>{crumb.label}</a>}
          </>
        ))}
      </nav>

      <header class="page__head">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1 class="page__title">{heading}</h1>
        {lead && <p class="page__lead">{lead}</p>}
        {updated && (
          <div class="page__meta">
            <p>Published by <a href="/about/">Cooked Finance</a></p>
            <p>Last substantively reviewed: <time datetime={updatedISO ?? undefined}>{updated}</time></p>
          </div>
        )}
      </header>

      <div class="prose page__body">
        <slot />
      </div>

      <div class="page__next">
        <p>{nextPrompt.text}</p>
        <a href={nextPrompt.href} class="btn-primary">{nextPrompt.label}</a>
      </div>
    </div>
  </main>

  <SiteFooter />
</Layout>

<style>
  .page { padding: clamp(2.25rem, 6vw, 5rem) 0 var(--section-space); }
  .breadcrumbs { max-width: 790px; margin: 0 auto 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; color: var(--color-mute); font-size: 0.78rem; }
  .breadcrumbs a { color: var(--color-body); text-underline-offset: 0.16em; }
  .page__head { max-width: 790px; margin-inline: auto; padding-bottom: clamp(2rem, 5vw, 3.25rem); border-bottom: 1px solid var(--color-hairline); }
  .page__title { max-width: 16ch; margin: 0.75rem 0 0; font-family: var(--font-serif); font-size: clamp(2.6rem, 8vw, 5.5rem); font-weight: 500; letter-spacing: -0.045em; line-height: 0.98; }
  .page__lead { max-width: 62ch; margin: 1.2rem 0 0; color: var(--color-body); font-size: clamp(1.05rem, 2vw, 1.2rem); line-height: 1.7; }
  .page__meta { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; color: var(--color-mute); font-family: var(--font-mono); font-size: 0.72rem; }
  .page__meta p { margin: 0; }
  .page__meta a { color: inherit; text-underline-offset: 0.16em; }
  .page__body { padding-top: 0.7rem; }
  .page__next { max-width: 790px; margin: 4rem auto 0; padding: clamp(1.4rem, 4vw, 2rem); display: flex; align-items: center; justify-content: space-between; gap: 1rem; border: 1px solid var(--color-hairline); border-radius: var(--radius-lg); background: var(--color-paper); }
  .page__next p { min-width: 0; margin: 0; max-width: 35ch; color: var(--color-body); font-weight: 620; }
  .page__next a { flex: 0 0 auto; }
  @media (max-width: 760px) { .page__next { align-items: stretch; flex-direction: column; } }
</style>
