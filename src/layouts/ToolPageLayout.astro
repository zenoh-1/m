---
import Layout from './Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  lead: string;
  eyebrow?: string;
}

const { title, description, path, heading, lead, eyebrow = 'Free home cost tool' } = Astro.props;
const canonicalPath = path.endsWith('/') ? path : `${path}/`;
const canonicalURL = new URL(canonicalPath, SITE.url).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: `${SITE.url}/tools/` },
      { '@type': 'ListItem', position: 3, name: heading, item: canonicalURL },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: heading,
    description,
    url: canonicalURL,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any web browser',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@id': `${SITE.url}/#organization` },
  },
];
---

<Layout title={title} description={description} path={canonicalPath} jsonLd={jsonLd}>
  <SiteHeader />
  <main id="main-content" class="tool-page">
    <div class="container-page">
      <nav class="tool-page__crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/tools/">Tools</a><span aria-hidden="true">/</span><span aria-current="page">{heading}</span>
      </nav>
      <header class="tool-page__head">
        <div class="tool-page__register"><span>Interactive Instrument</span><span>Local Values Only</span></div>
        <span class="eyebrow">{eyebrow}</span>
        <h1>{heading}</h1>
        <p>{lead}</p>
      </header>
      <div class="tool-page__body"><slot /></div>
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
  .tool-page { padding: clamp(1.8rem, 5vw, 4rem) 0 var(--section-space); }
  .tool-page__crumbs { max-width: 980px; margin: 0 auto 1.5rem; display: flex; flex-wrap: wrap; gap: 0.4rem; color: var(--color-mute); font-size: 0.76rem; }
  .tool-page__crumbs a { color: var(--color-body); text-underline-offset: 0.16em; }
  .tool-page__head { max-width: 1040px; margin-inline: auto; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.65fr); gap: 1.5rem 3rem; align-items: end; padding-bottom: clamp(1.8rem, 5vw, 3rem); }
  .tool-page__register { grid-column: 1 / -1; display: flex; justify-content: space-between; gap: 1rem; padding: 0.65rem 0; border-block: 1px solid var(--color-hairline-strong); color: var(--color-mute); font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .tool-page__head .eyebrow { grid-column: 1 / -1; }
  .tool-page__head h1 { max-width: 15ch; margin: 0; font-family: var(--font-serif); font-size: clamp(2.7rem, 7vw, 5rem); font-weight: 500; letter-spacing: -0.05em; line-height: 0.96; }
  .tool-page__head p { margin: 0; color: var(--color-body); font-size: 1.05rem; line-height: 1.7; }
  .tool-page__body { max-width: 1040px; margin-inline: auto; }
  @media (max-width: 760px) {
    .tool-page__head { grid-template-columns: 1fr; align-items: start; }
    .tool-page__head .eyebrow { grid-column: auto; }
    .tool-page__register { grid-column: auto; }
    .tool-page__head h1 { max-width: 14ch; }
  }
</style>
