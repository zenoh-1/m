---
import '../styles/global.css';
import ConsentNotice from '../components/ConsentNotice.astro';
import SiteEnhancements from '../components/SiteEnhancements.astro';
import { SITE, buildStructuredData } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  structuredData?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | string;
  noindex?: boolean;
  type?: 'website' | 'article';
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  path,
  image = SITE.ogImage,
  structuredData = false,
  jsonLd,
  noindex = false,
  type = 'website',
} = Astro.props;

const rawPath = path ?? Astro.url.pathname;
const canonicalPath = rawPath === '/' || rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
const canonicalURL = new URL(canonicalPath, Astro.site ?? SITE.url).href;
const pageJsonLd = typeof jsonLd === 'string' ? jsonLd : jsonLd ? JSON.stringify(jsonLd) : null;
const siteJsonLd = structuredData ? buildStructuredData() : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="theme-color" content="#f3ecdf" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cooked Finance home cost intelligence tools" />
    <meta property="og:locale" content={SITE.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="Cooked Finance home cost intelligence tools" />

    {siteJsonLd && <script type="application/ld+json" set:html={siteJsonLd} />}
    {pageJsonLd && <script type="application/ld+json" set:html={pageJsonLd} />}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <SiteEnhancements />
    <ConsentNotice />
    <slot />
  </body>
</html>
