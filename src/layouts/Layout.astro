---
import '../styles/global.css';
import { SITE, buildStructuredData } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** Path-only canonical (e.g. "/"). Defaults to the current page path. */
  path?: string;
  image?: string;
  /** Include the FAQ + WebApplication JSON-LD graph (homepage). */
  structuredData?: boolean;
  keywords?: string[];
  /** Keep the page out of search indexes (error pages, etc.). */
  noindex?: boolean;
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  path,
  image = SITE.ogImage,
  structuredData = false,
  keywords = SITE.keywords,
  noindex = false,
} = Astro.props;

const siteName = SITE.name;

// Build an absolute canonical URL from the configured site origin.
// Normalize to a trailing slash (matching Astro's default page output and the
// generated sitemap) so canonical + sitemap never disagree.
const rawPath = path ?? Astro.url.pathname;
const canonicalPath =
  rawPath === '/' || rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
const canonicalURL = new URL(canonicalPath, Astro.site ?? SITE.url).href;
const ogImage = image;
const jsonLd = structuredData ? buildStructuredData() : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content={siteName} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph (Facebook, LinkedIn, Discord, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cooked Finance — Free Financial Health Score Calculator" />
    <meta property="og:locale" content={SITE.locale} />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitterHandle} />
    <meta name="twitter:creator" content={SITE.twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SITE.twitterImage} />
    <meta name="twitter:image:alt" content="Cooked Finance — Free Financial Health Score Calculator" />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

    <!-- Google Analytics (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SG7VP5RKS2"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-SG7VP5RKS2');
    </script>

    <!--
      Google AdSense: drop your publisher script here when approved, e.g.
      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script>
    -->
  </head>
  <body>
    <a href="#check" class="skip-link">Skip to the quick check</a>

    <!-- Signature Vercel-style mesh gradient backdrop (decorative, fixed). -->
    <div class="mesh-backdrop" aria-hidden="true">
      <div class="mesh-blob mesh-blob--a"></div>
      <div class="mesh-blob mesh-blob--b"></div>
      <div class="mesh-blob mesh-blob--c"></div>
    </div>

    <slot />
  </body>
</html>

<style>
  .mesh-backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .mesh-blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(90px);
    opacity: 0.5;
    will-change: transform;
  }

  /* Develop pair: blue → cyan */
  .mesh-blob--a {
    top: -12%;
    left: -8%;
    width: 48vw;
    height: 48vw;
    background: radial-gradient(circle at 30% 30%, #007cf0, transparent 70%);
    animation: float-slow 18s ease-in-out infinite;
  }

  /* Preview pair: violet → pink */
  .mesh-blob--b {
    top: -6%;
    right: -10%;
    width: 42vw;
    height: 42vw;
    background: radial-gradient(circle at 60% 40%, #7928ca 0%, #ff0080 60%, transparent 75%);
    animation: float-slow 22s ease-in-out infinite reverse;
  }

  /* Ship pair: coral → amber (low, faint) */
  .mesh-blob--c {
    top: 20%;
    left: 30%;
    width: 38vw;
    height: 38vw;
    background: radial-gradient(circle at 50% 50%, #ff4d4d 0%, #f9cb28 55%, transparent 72%);
    opacity: 0.28;
    animation: float-slow 26s ease-in-out infinite;
  }

  /* The gradient lives at hero scale only — fade it out below the fold. */
  .mesh-backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(10, 10, 10, 0.55) 45%,
      var(--color-canvas) 78%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .mesh-blob { animation: none; }
  }
</style>
